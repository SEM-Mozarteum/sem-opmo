;;; SPECTRAL REPETITIONS

;;; ---------------------------------------------------------

;; integer divisions of a quarter note
(setf divs (gen-integer 2 16)) ; division of 4/4
(setf quarters 4) ; number of quarters

;; display with cmd-2
(loop for i in divs
      collect
      (loop repeat quarters
            collect
            (loop repeat i
                  collect (/ 1 i))))

;; selected n-tuplets
(setf divs-list '(12 16 20 28))

;; display with cmd-2

(setf repetitions
      (mcflatten
      (loop for i in divs-list
      collect
      (loop repeat quarters
            collect
            (loop repeat i
                  collect (/ 1 i)))))

(setf pitches
      (loop for i in rep

(make-omn
 :length repetitions
 :pitch '((c4) (d4) (e4) (f4))
 :span :length)
            
