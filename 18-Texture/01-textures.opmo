;;; TEXTURES

;;; ---------------------------------------------------------

;;; Spectral Repetitions

;; rhythmic acceleration = spectral repetitions 
;; view with cmd-1 and cmd-2
(loop for i from 1 to 14
      collect
        (loop repeat i         
              collect (/ (/ 1 i) 4)))

;; Stretched accereration with rounded transition
;; view with cmd-1 and cmd-2
(loop for i in
        (gen-transition 1 14 20 1 :rounded t)
      collect
        (loop repeat i         
              collect (/ (/ 1 i) 4)))

;; 7 voices all starting from 1/4 and ending on 1/32 upto 1/56
;; view with cmd-2
(length-plot
 (setf diff-end 
       (loop for divisor from 8 to 14
             collect
               (loop for i in
                       (gen-transition 1 divisor 20 1 :rounded t)
                     append
                       (loop repeat i         
                             collect (/ (/ 1 i) 4)))))
 :join-points t :point-radius 1.5)

;; For each voice one pitch creating a chromatic cluster
(setf pitches1
      (loop for i in diff-end
            for j in (midi-to-pitch 
                      (loop for m from 50 to 62 by 1 collect m))
            collect (gen-repeat (length i) j)))

;; Make voices and reverse their order
(nreverse
 (make-omn
  :length diff-end
  :pitch pitches1
  :velocity '(p)))

;; 8 voices all starting from 1/4 and ending on 1/56
;; Transition with different curves
;; View with cmd-2
(length-plot
 (setf diff-curve
       (loop for curve from 0.6 to 1.4 by 0.1
             collect
               (loop for i in
                       (gen-transition 1 14 20 curve :rounded t)
                     append
                       (loop repeat i         
                             collect (/ (/ 1 i) 4)))))
 :join-points t :point-radius 1.5)

;; For each voice one pitch creating a chromatic cluster
(setf pitches2
      (loop for i in diff-curve
            for j in (midi-to-pitch 
                      (loop for m from 50 to 62 by 1 collect m))
            collect (gen-repeat (length i) j)))

;; Make voices and reverse their order
(nreverse
 (make-omn
  :length diff-curve
  :pitch pitches2
  :velocity '(p)))

;;; ---------------------------------------------------------

;;; 25.6.2026

;;; Length and pitch construction with a magic square

;; Numbers from 1 to 25 distributed in 5 lists 
;; with the same sum of 65
(list-plot
 (setf magic5
       (magic-square 5 :seed 123))
 :join-points t)

(find-sum magic5) ; => (65 65 65 65 65)

;; Set the fundamental
(setf fundamental (pitch-to-hertz 'c2))

;; Calculating harmonics from fundamental
;; using the magic square values as indexes
(setf pitches
      (loop for i in magic5
            collect
            (loop for j in i
                  collect
                  (hertz-to-pitch
                   (* fundamental j)
                   :quantize 1/2))))

;; lowest id = longest duration (25/16)
;; highest id = shortest duration (1/16)
(setf lengths
      (loop with flma = (flatten magic5)
            ;; sum of minimum and maximum value in magic square
            with ma = (+ (find-max flma) 
                         (find-min flma))
            for i in magic5
            collect
              (loop for j in i
                    collect
                      ;; highest id:
                      ;; (* (- (+ 25 1) 25) 1/16) = 1/16
                      ;; lowest id:
                      ;; (* (- (+ 25 1) 1) 1/16) = 25/16
                      (* (- ma j) 1/16))))

;; view with cmd-2
(make-omn
 :length lengths
 :pitch pitches
 :velocity '(p))

#|
Each voice of the original is repeated 10 times and
ordered randomly => 10 voices with all of the material
in a different order = 10 times the first material in
 different order then 2nd, 3rd, etc.
|#

;; view with cmd-2
(loop with seed = (init-seed 123)
      repeat 10
      collect
        (loop 
           for i in material
           collect
             (rnd-order i))) 

#|
Each voice of the original is repeated 10 times,
ordered randomly and concatenated => 5 voices
with 10 times the latin square randomly ordered.
|#

;; view with cmd-2
(matrix-transpose
 (loop with seed = (init-seed 123)
       repeat 10
       collect
         (loop  
            for i in material
            collect
              (rnd-order i))))

;;; ---------------------------------------------------------

;;; Field of random durations with the same sum
;;; using random-sum-to-size

(progn
  (setf events 60)

  ;; lengths adding up to the same overall duration of 60
  ;; 1. voice = 6 lengths, 2 voice = 7, etc.
  (setf lengths
        (loop with seed = (init-seed 17)
              ;; number of durations
              for i from 6 to 12
              collect 
                (loop for x in 
                        ;; integers between 2 and 10
                        (rnd-sum-to-size
                         ;; add up randomly to 60 events
                         events i 
                         (gen-integer 2 10))
                      ;; converted to quarters
                      collect (/ x 4))))

  (setf pitches 
        ;; convert integer to pitches
        (integer-to-pitch 
         (loop for i in lengths
               ;; integers from 0 to 6 (c4 to fs4)
               for k from 0
               collect (gen-repeat (length i) k))))
 
  ;; cmd-2 to view
  (assign-variable 'mat      
                   (make-omn
                    :length lengths
                    :pitch (reverse pitches)
                    :velocity '(pp)
                    :articulation '(marc)))

  (def-score cluster-score
      (:key-signature 'atonal
       :time-signature '(4 4)
       :tempo 60
       :layout (list
                (bracket-group
                 ;; group of instruments surrounded by one
                 ;; bracket with common continuous bar line
                 (violin-layout 'violin1
                                :name "Violin 1" :abbr "Vn 1")
                 (violin-layout 'violin2
                                :name "Violin 2" :abbr "Vn 2")
                 (violin-layout 'violin3
                                :name "Violin 3" :abbr "Vn 3")
                 (violin-layout 'violin4
                                :name "Violin 4" :abbr "Vn 4")
                 (violin-layout 'violin5
                                :name "Violin 5" :abbr "Vn 5")
                 (violin-layout 'violin6
                                :name "Violin 6" :abbr "Vn 6")
                 (violin-layout 'violin7
                                :name "Violin 7" :abbr "Vn 7"))))
               
    (violin1
     :omn mat1
     :sound 'gm
     :program 'violin)
  
    (violin2
     :omn mat2
     :sound 'gm
     :program 'violin)
  
    (violin3
     :omn mat3
     :sound 'gm
     :program 'violin)
  
    (violin4
     :omn mat4
     :sound 'gm
     :program 'violin)
  
    (violin5
     :omn mat5
     :sound 'gm
     :program 'violin)

    (violin6
     :omn mat6
     :sound 'gm
     :program 'violin)

    (violin7
     :omn mat7
     :sound 'gm
     :program 'violin))

  (defparameter *default-notation-editor* "Sibelius.app")

  (musicxml-to-editor)

  ) ; end of progn

;;; ---------------------------------------------------------

;;; Cartesian function for lengths creation

(progn
  ;; all combinations of all combinations of two lists
  (setf lengths
        (cartesian
         (cartesian '((q h h.) (q h h.)))))

  ;; 8 voices
  ;; (/ (length lengths) 64)

  ;; parameter creation all in one
  (assign-variable 'mat
                   (make-omn
                    :length (mcflatten (gen-divide 64 lengths))
                    :pitch '(c4 d4 e4 f4 g4 a4 b4)
                    :velocity '(p)
                    :span :length))

  (def-score cartesian-score
      (:key-signature 'atonal
       :time-signature '(4 4)
       :tempo 50
       ;; cut score after 264 measures 
       ;; since voices have different lengths
       :end 264 
       :layout (list
                (bracket-group
                 ;; group of instruments surrounded by one
                 ;; bracket with common continuous bar line
                 (violin-layout 'violin1
                                :name "Violin 1" :abbr "Vn 1")
                 (violin-layout 'violin2
                                :name "Violin 2" :abbr "Vn 2")
                 (violin-layout 'violin3
                                :name "Violin 3" :abbr "Vn 3")
                 (violin-layout 'violin4
                                :name "Violin 4" :abbr "Vn 4")
                 (violin-layout 'violin5
                                :name "Violin 5" :abbr "Vn 5")
                 (violin-layout 'violin6
                                :name "Violin 6" :abbr "Vn 6")
                 (violin-layout 'violin7
                                :name "Violin 7" :abbr "Vn 7")
                 (violin-layout 'violin8
                                :name "Violin 8" :abbr "Vn 8"))))
               
    (violin1
     :omn mat1
     :sound 'gm
     :program 'violin)
  
    (violin2
     :omn mat2
     :sound 'gm
     :program 'violin)
  
    (violin3
     :omn mat3
     :sound 'gm
     :program 'violin)
  
    (violin4
     :omn mat4
     :sound 'gm
     :program 'violin)
  
    (violin5
     :omn mat5
     :sound 'gm
     :program 'violin)

    (violin6
     :omn mat6
     :sound 'gm
     :program 'violin)

    (violin7
     :omn mat7
     :sound 'gm
     :program 'violin)
    (violin8
     :omn mat8
     :sound 'gm
     :program 'violin))

  (defparameter *default-notation-editor* "Sibelius.app")

  (musicxml-to-editor)
  ) ; end of progn