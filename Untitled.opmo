

(piano-lh
   :omn piano-lh
   :channel 8
   :sound 'gm
   :program 'acoustic-grand-piano
   :volume 100
   :pan 64
   :controllers (91 '(60))
   )
  )


(defmacro om-system 
          (name omn ch prog snd
                &key
                (vol 100) (pan 64) (ctl NIL))

  `(list ,name
        :omn ,omn
        :channel ,ch
        :sound ,snd
        :program ,prog
        :volume ,vol
        :pan ,pan
        :controllers ,ctl
        ))

(macroexpand '(om-system violin mat1 2 'Violin 'gm))

(om-system 'violin 'mat1 2 'Violin)