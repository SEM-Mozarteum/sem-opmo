;;; ENVELOPES

;;; ---------------------------------------------------------

;;; xy-plot

;; an envelope as list of xy-pairs
(setf env '(0 0  1 2  3 1  4 3  6 0))

;; xy-plot to display envelope
(xy-plot env :join-points t :point-radius 2 :style :axis)

;;; envelope-length

;; how many points in env
(envelope-length env) ; => 5

;;; normalize-envelope

;; normalize y-values to maximum of 1
(setf env-norm (normalize-envelope env))

;; see original and normalized envelope
(xy-plot
(list env env-norm)
:join-points t :point-radius 2 :style :axis)

;;; scale-envelope

;; scale y-values by factor
(setf env-scale (scale-envelope env 2))

;; see original, normalized and scaled envelope

(xy-plot
(list env env-norm env-scale)
:join-points t :point-radius 2 :style :axis)

;;; envelope-interp

;; get y-value at any position
(envelope-interp 2.5 env)

;; see the original envelope and the extracted point
(xy-plot (list env '(2.5 1.25)) 
         :join-points t :point-radius 2 :style :axis)

;;; envelope-samples

;; Take 20 aequidistant samples from envelope
(xy-plot
(setf env-samp
(envelope-samples env 20))
:join-points t :point-radius 2 :style :axis)

;; see original and samples envelope
(xy-plot
(list env env-samp)
:join-points t :point-radius 2 :style :fill)

;;; envelope-y

;; see the y-values only with list-plot
;; (same as env-samp with xy-plot)
(list-plot
 (setf y-values (envelope-y env-samp))
 :join-points t :point-radius 2 :style :axis)

;;; make-xy

;; add aequidistant x-values to y-values
;; to recreate the original envelope (env-samp)
(xy-plot
(setf env-new (make-xy 
               (gen-integer 1 (length y-values)) 
               y-values))
:join-points t :point-radius 2 :style :axis)

;;; envelope-reverse

;; reverse the envelope
(xy-plot
(setf env-rev
(envelope-reverse env-new))
:join-points t :point-radius 2 :style :axis)

;; see sampled envelope and and its reversed version
(xy-plot
(list env-new env-rev)
:join-points t :point-radius 2 :style :fill)

;;; map envelope to pitches

;; Map the envelope to pitches between c4 and gs5 
(setf twenty-pitches
      (pitch-list-plot
       ;; plot pitches
       (vector-map
        ;; map this to the envelope
        (midi-to-pitch
         ;; make midi scale
         (gen-integer 60 80))
        ;; extract the y-values from the envelope
        (envelope-y env-samp))
       :point-radius 1.5 :join-points t :style :fill))