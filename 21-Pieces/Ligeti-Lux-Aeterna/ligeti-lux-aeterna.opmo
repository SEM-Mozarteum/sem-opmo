;;; György Ligeti, Lux Aeterna (1966)
;;; https://en.wikipedia.org/wiki/Lux_Aeterna_(Ligeti)

;;; Micropolyphony

#|
"Technically speaking I have always approached musical texture 
through part-writing. Both Atmosphères and Lontano have a dense 
canonic structure. But you cannot actually hear the polyphony, 
the canon. You hear a kind of impenetrable texture, something 
like a very densely woven cobweb. I have retained melodic lines 
in the process of composition, they are governed by rules as 
strict as Palestrina's or those of the Flemish school, but the 
rules of this polyphony are worked out by me. The polyphonic 
structure does not come through, you cannot hear it; it remains 
hidden in a microscopic, underwater world, to us inaudible. 
I call it micropolyphony (such a beautiful word!)." 
(Ligeti, quoted in Bernard 1994, 238).
|#

;;; ---------------------------------------------------------

;;; Lengths

;;; s. Howie Kenty, Patterns and Structure 
;;; in György Ligeti's LUX AETERNA, page 9

;; Tuplets for all 8 voices
(setf all-divisions '(3 5 4 3 5 4 3 5))

;; 30 random lengths for each voice with the sum of 96
;; 24 measures of 4/4 = 96 quarters 
(setf quarterlist
      (loop with seed = (init-seed 31166)
            repeat 8
              collect
              (rnd-sum-to-size 
                              96 30 
                              '(2 3 4 5 6 7 8))))
;; Tests for the same number of notes and quarters:
(loop for i in quarterlist collect (length i))
(loop for i in quarterlist collect (sum i))

(setf lengths
      ;; loop in lists of quarters
      (loop for qlist in quarterlist
            ;; for each voice one tuplet type
            for division in all-divisions
            collect (loop with tup = (* division 4)
                          ;; tuplets in measure (4/4)
                          for quarters in qlist
                          ;; random number
                          for rand = (rndn 1 1 (1- division))
                          ;; rest (part of a tuplet)
                          for rest = (/ rand tup)
                          ;; overall duration - rest
                          for dur = (- (/ (* division quarters) tup) rest)
                          for len = (list (* -1 rest) dur)
                          ;; use append to create one list instead of
                          ;; several with different time-signatures
                          ;; coming from the different quarters
                          append len)))

;;; s. Howie Kenty, Patterns and Structure 
;;; in György Ligeti's LUX AETERNA, page 8

;; 30 pitches for the first 24 measures
(setf melody
      '(f4 f4 f4 e4 f4 g4 fs4 g4 f4 eb4 
           ab4 db4 eb4 f4 gb4 bb4 a4 bb4 c5 bb4 
           ab4 f4 g4 eb4 fb4 eb4 gb4 f4 bb4 g4))

;; Combine length and pitches to omn voices
(setf voices
      (make-omn :length lengths
                :pitch (list melody)
                :velocity '(pp)))

;; To get the right notation first convert to the
;; wanted time-signature (4 4) and then quantize
;; the voices to the given tuplets
(setf quant-voices
(loop for i in voices
      collect
        (quantize
         (omn-to-time-signature
          i
          '(4 4))
         '(2 3 4 5))))

;; Assign the voices to variables
(assign-variable 'voice quant-voices)
                
(def-score lux-aeterna
    (:title "Lux Aeterna"
     :composer "György Ligeti"
     :copyright "Copyright © 1966"
     :key-signature 'chromatic
     :time-signature '((1 1 1 1) 4)
     :tempo 50
     :layout (bracket-group
              (soprano-voice1-layout 'soprano1)
              (soprano-voice2-layout 'soprano2)
              (soprano-voice3-layout 'soprano3)
              (soprano-voice4-layout 'soprano4)
              (alto-voice1-layout 'alto1)
              (alto-voice2-layout 'alto2)
              (alto-voice3-layout 'alto3)
              (alto-voice4-layout 'alto4)))
  
  (soprano1
   :omn voice1
   :channel 1
   :sound 'gm
   :program 'choir-aahs
   :volume 100
   :pan 16
   :controllers (91 '(48))
   )
  
  (soprano2
   :omn voice2
   :channel 2
   :sound 'gm
   :program 'choir-aahs
   :volume 100
   :pan 16
   :controllers (91 '(48))
   )

  (soprano3
   :omn voice3
   :channel 9
   :sound 'gm
   :program 'choir-aahs
   :volume 100
   :pan 16
   :controllers (91 '(48))
   )
  
  (soprano4
   :omn voice4
   :channel 10
   :sound 'gm
   :program 'choir-aahs
   :volume 100
   :pan 16
   :controllers (91 '(48))
   )
  
  (alto1
   :omn voice5
   :channel 3
   :sound 'gm
   :program 'choir-aahs
   :volume 100
   :pan 41
   :controllers (91 '(48))
   )
  
  (alto2
   :omn voice6
   :channel 4
   :sound 'gm
   :program 'choir-aahs
   :volume 100
   :pan 41
   :controllers (91 '(48))
   )

  (alto3
   :omn voice7
   :channel 11
   :sound 'gm
   :program 'choir-aahs
   :volume 100
   :pan 41
   :controllers (91 '(48))
   )
  
  (alto4
   :omn voice8
   :channel 12
   :sound 'gm
   :program 'choir-aahs
   :volume 100
   :pan 41
   :controllers (91 '(48))
   ))

(display-musicxml 'lux-aeterna)

;;; ---------------------------------------------------------

#|
Length in quintuplets 
Opusmodus solution without loop by Janusz Podrazik)

(progn
  (init-seed 123)
  (setf quarterlist
        (rnd-sum-to-size 96 28 '(2 3 4 5 6 7 8)))
  (setf division 5)
  (setf tup (* division 4))
  (setf quarters quarterlist)
  (setf lengths 
        (gen-loop
         28
         (progn
           (setf rand (rndn 1 1 (1- division)))
           (setf rest (/ rand tup))
           (setf qs (car (setf quarters 
                               (gen-rotate 1 quarters))))
           (setf dur (- (/ (* division qs) tup) rest))
           (list (* -1 rest) dur))))

  (quantize
   (omn-to-time-signature
    (make-omn :length lengths
              :pitch '(c4))
    '(4 4))
   '(1 2 4 5))
  ) ; end of progn
|#
