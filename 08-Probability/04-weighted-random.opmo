;;; WEIGHTED RANDOM

#|
Weighted random is a method of selecting items from a list 
where each item has a different probability of being chosen. 
Unlike a standard random selection where all items have an 
equal chance, weighted randomness allows certain items to be 
picked more frequently than others based on their assigned 
"weight" or probability. 
|#

;;; ---------------------------------------------------------

#|
Weighted randomness can be achieved by randomly selecting 
from a list with a different number of elements:
list of 10 elements: weights: 10% = 1, 30%  = 3, 60% = 6 
|#
(setf weight-lst
      '(1 3 3 3 6 6 6 6 6 6))

(rnd-sample 20 weight-lst)
;; e.g. (1 6 6 6 6 6 6 3 3 6 1 6 6 3 6 6 3 6 6 3)
;; see the  different results

;; example with pitches
(rnd-sample 20 '(c4 c4 c4 c4 d4 d4 f4 g4 g4 g4) :seed 1234)

;;; ---------------------------------------------------------

;;; gen-weight

;; gen-weight can be used to generate lists based on a series 
;; of probabilistic weightings.

;; 4 times more mp than ff
(gen-weight 10 '((ff 1) (mp 4)) :seed 123)
;; => (mp mp ff mp ff mp ff mp mp mp)

;; See the distribution with 100 elements
(pitch-list-plot
 (gen-weight 100 '((c4 5) (d4 1) (e4 3) (f4 2) (g4 3)) 
             :seed 45)
 :style :axis :point-radius 2 :join-points nil)

;; With OMN length structures
(gen-weight 10 '(((5q = = = =) 4) ((h) 2)
                 ((e = s = = =) 1) ((q - q - e =) 2)))

;; a different example
(flatten (gen-weight 40 '(((s) 2) ((h) 4) ((w) 4))))

;; chords with weighted number of pitches in a chord
(setf weights (gen-weight 20 
                          '((1 5) (2 4) (3 3) (4 2) (5 1)) 
                          :seed 123))

;; loop through list numbers in chord
(loop for i in weights 
      with seed = (init-seed 234) 
      for x = (midi-to-pitch (rndn i 60 80))
      if (listp x) 
        append (chordize x)
      else 
        collect x)

;; weight-pick is the same as gen-weight 
;; but returns one element only
(loop repeat 20
      for x = (weight-pick '((1 5) (2 4) (3 3) (4 2) (5 1)))
      for y = (midi-to-pitch (rndn x 60 80))
      if (listp y) 
        append (chordize y)
      else 
        collect y)

;;; ---------------------------------------------------------

;;; Expnentially increasing weights

#|
There are several ways to visualize different parametrical
data, s. Graph Tools in the documentation. 
|#

;; 40 integers from 5 to 95 = changing weights
(list-plot
(setf lin-weights (gen-transition 2 95 120 2 :rounded t))
:join-points t)

;; list of pitches randomly chosen with increasing probability
(setf pitch-list '(g4 bb4 d5 e5 f5)) 

(setf pitches
      (loop for i in lin-weights
            initially (init-seed 123)   
            append
              ;; calculating one result each time
              ;; with a fixed probability of 10 for c4
              ;; and an increasing probability from 2 to 95
              ;; for randomly chosen pitches from a list
              (gen-weight 1 (list 
                             (list (rnd-pick pitch-list)
                                              i)
                             ;; c4 with fixed probability
                             (list 'c4 10)))))

(make-omn
 :pitch pitches
 :length '(1/16)
 :span :pitch)

;;; ---------------------------------------------------------

;;; Using envelope for changing weights
;;; (See more about envelopes in the "Vector" chapter.)

;; envelope of probabilities
(setf weight-env
      ;; xy-plot draws one or more x-y data series as a graph.
      ;; needs lists of x/y values
      ;; (y-values are the probabilities)
      (xy-plot 
       ;; a list of x/y values
       '(0 1 1 2 2 3 3 5 5 10 6 30 7 50 10 80 13 90)
       :join-points t :point-radius 2))

;; taking 120 equally spaced x/y-values from weight-env
(setf pitch-prob-env
      (xy-plot 
       (envelope-samples weight-env 120)
       :join-points t :point-radius 2))

;; rounding probabilities (y-values) from envelope
;; for gen-weight (needs integers)
(setf pitch-prob
  (list-plot
   (loop for i in (envelope-y pitch-prob-env)
           ;; only the y values are taken
           collect (round i)) ; round to integer
   :join-points t :point-radius 2 :style :axis))

;; weighted pitches
(setf weight-pitch
      (pitch-list-plot
       ;; cycle through the pobability list
       (loop for i in pitch-prob
             initially (init-seed 123)   
             append
               ;; create this form for each evaluation:
               ;; (gen-weight 1 '((f4 1) (c4 40)))
               (gen-weight 1 (list 
                              (list (rnd-pick pitch-list) i)
                              ;; c4 with fixed probability
                              (list 'c4 30))
                           :seed (seed)))
       :join-points t :point-radius 2 :style :fill))

;; weighted articulations
(setf weight-articulation
   (loop for i in pitch-prob
     initially (rnd-seed 2358)   
     append
     (gen-weight 1 (list 
                    (list 'stacc i) 
                    (list '- 40))
                 ; fixed probability ord
                 :seed (seed))))

;; preview score
(ps 'gm
    :multi (make-omn
            :length '(s)
            :pitch weight-pitch
            :articulation weight-articulation
            :span :pitch)
    :time-signature '(4 4))

;;; ---------------------------------------------------------

;;; length-weight

#| 
The function length-weight enables you to create rest 
lengths in a list of note lengths. The :weight keyword 
allows you to control the weighting between note and rest 
values in relation to a sequence lengths. 
|#

(setf len1 '(1/4 1/16 1/8 1/16 1/2 1/8 1/8 1/8 1/8))

(length-weight len1) ; 50/50 %

;; 3 times more notes than rests
(length-weight len1 :weight '(3 1) :seed 54)
;;  (-1/4 1/16 1/8 -1/16 1/2 1/8 1/8 1/8 1/8)

;; see with cmd-2
(append
(length-weight '((q c4 d4 e4 f4 g4 a4 b4)
                 (q c4 d4 e4 f4 g4 a4 b4))
               :weight '((3 1) (5 2))
               :seed 52)
 (list '(q c4 d4 e4 f4 g4 a4 b4)))
;; ((-q - e4 f4 - a4 b4) (-q - e4 f4 - - b4)