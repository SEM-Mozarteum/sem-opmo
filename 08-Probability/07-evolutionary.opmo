;;; EVOLUTIONARY

;;; ---------------------------------------------------------

;;; gen-mutate

#|
gen-mutate returns a random element from a list and 
mutates randomly to a given mutation probability.
The function is modelled after the Darwinian evolutionary 
theory.
|#

;;; ---------------------------------------------------------
;;; Random operation of mutation type not clear!!!
;;; Deviation or Replacement?
;;; ---------------------------------------------------------

;; first population
(setf lst (rndn 3 :seed 345))
;; '(0.10542764 0.43240792 0.72332895)

;; Calculate 24 mutation lists
;; The default count of mutations is 1, therefore up to
;; one element is mutating
(setf mut-lists (gen-mutate 12 lst :seed 123))

#|
((0.10542764 0.43240792 0.72332895) 
 (0.10542764 0.43240792 0.72332895) 
 (0.71371884 0.43240792 0.72332895)  ; 1.
 (0.71371884 0.43240792 0.72332895) 
 (0.71371884 0.43240792 0.72332895) 
 (0.71371884 0.43240792 0.72332895) 
 (0.71371884 0.15850497 0.72332895)  ; 2.
 (0.71371884 0.15850497 0.80816484)  ; 3.
 (0.82697636 0.15850497 0.80816484)  ; 1
 (0.82697636 0.15850497 0.80816484) 
 (0.82697636 0.15850497 0.80816484) 
 (0.7484988  0.15850497 0.80816484)) ; 1.
|#

;; flatten the mut-lists to apply the pitches to one vector
;; and put them together again in trichords
(setf mutation1 
      (gen-divide 3 (vector-to-pitch '(-12 12) 
                                 (flatten mut-lists))))

(setf omn-mutation1
(flatten
(make-omn :length '(s)
          :pitch mutation1
          :span :pitch)))

(setf omn-mutation2
(flatten
(make-omn :length '(q)
          :pitch (chordize mutation1)
          :span :pitch)))

;;; ---------------------------------------------------------

;;; gen-population

#| gen-population returns a random population with n floating
point numbers between 0 and 1. Each list will contain a 
number of elements between low and high. |#

;; 5 generations of lengths between 3 and 7
(setf population (gen-population 5 3 7 :seed 56))

#|
((0.9078272 0.05199222 0.95386976 0.5921951 0.93476516) ; 5
 (0.19755595 0.18478737 0.18754587 0.2855475 0.4052874) ; 5
 (0.6416326 0.86454636 0.3624713 0.95245344 0.33112416 
  0.49055362) ; 6 
 (0.76038296 0.25854617 0.27156326 0.36454925) ; 4
 (0.17618607 0.38432425 0.37086514 0.33166522)) ; 4
|#

;;; ---------------------------------------------------------

;;; gen-mutate-population

#| The gen-mutate-population function will randomly select 
some of the populations to be mutated. This function takes 
a population in the form of a list of lists.
The probability is the likelyness of the list to mutate. |#

(setf mutation2 (gen-mutate-population
                population :prob 0.2 :seed 34))

#|
((0.9078272 0.05199222 0.95386976 0.5921951 0.93476516) 
 (0.19755595 0.18478737 0.18754587 0.2855475 0.4052874) 
 (0.3392996 0.86454636 0.3624713 0.95245344 0.33112416 
  0.49055362) 
;; only row 3, first number mutated
 (0.76038296 0.25854617 0.27156326 0.36454925) 
 (0.17618607 0.38432425 0.37086514 0.33166522))
|#

;; The count is the number of populations which can mutate 
;; (rnd low/high)
(setf mutation3
      (gen-mutate-population population 
                             :prob 0.6 :count '(1 3) 
                             :seed 1234))

#|
((0.9078272 0.05199222 0.95386976 0.5921951 0.44780603) 
;; last number 
 (0.19755595 0.18478737 0.23864259 0.2855475 0.4052874) 
;; third number
 (0.46458408 0.86454636 0.3624713 0.95245344 0.33112416 
  0.49055362) 
;; first number 
 (0.6103702 0.25854617 0.27156326 0.41215798) 
;; first and last number 
 (0.17618607 0.38432425 0.37086514 0.33166522))
|#

;; flatten is used to make it visible in list-plot
(list-plot (list (flatten population) 
                 (flatten mutation3)) 
           :join-points t
           :point-radius 1.5
           :style :fill)

;; make chords from populations
(setf pop-chords
(chordize 
 (sort-asc 
  (gen-divide 5 (vector-to-pitch '(-7 19)
                                 (flatten population))))))

;; make chords from mutations
(setf mut-chords                                 
(chordize 
 (sort-asc 
  (gen-divide 5 (vector-to-pitch '(-7 19) 
                                 (flatten mutation3))))))

;; alternate original and mutated chord
(mat-trans (list pop-chords mut-chords))

;;; ---------------------------------------------------------

;;; gen-morph

;; gen-morph is used to gradually replace items in one list 
;; with items from another.

;; A chord transition in 6 steps
(chordize-list 
 (gen-morph 6 '(b3 c4 d4 e4 f4)
            '(cs5 ds5 fs5 gs5 as5)))

;; Transition between random chords
(chordize-list 
 (gen-morph 12 (sort-asc 
                 (integer-to-pitch (rndn 8 -24 0 :seed 34)))
             (sort-asc 
              (integer-to-pitch (rndn 8 0 24 :seed 12)))))
  
;; A transition from one wholetone scale to the other 
;; in 12 steps
(setf wholetone-1 '(0 2 4 6 8 10) 
      wholetone-2 '(1 3 5 7 9 11))

;; three different transitions between wholetone scales
(setf wt-series 
      (gen-loop 3 (chordize-list
                   (integer-to-pitch 
                    (gen-morph 6 wholetone-1 wholetone-2)))))

;;; ---------------------------------------------------------

;;; gen-crossover

;; This function returns two child lists from the parent 
;; lists, at random. Every 2 chords have the sum of all 
;; pitches
(gen-loop 10 (chordize
              (gen-crossover
               '(c4 d4 e4 f4 g4 a4) '(cs4 ds4 fs4 gs5 as4)))
          :seed 123)

;; Lengths and dynamics can also be processed this way:
(gen-crossover
 '(f f f mf ff) '(p p p mp pp p) :seed 21)
;; => ((f p p mp pp p) (p f f mf ff))

;; and also with OM notation
(gen-loop 5 (gen-crossover
             '(e = = = q =) '(s = = = e s = h)) 
          :seed 34)