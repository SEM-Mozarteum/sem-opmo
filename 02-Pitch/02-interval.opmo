;;; INTERVAL

#|
In contrast to defined pitches, intervals describe their 
relative distance.
|#

;;; ---------------------------------------------------------

;;; interval-map / interval-to-pitch

;; a list of ascending and descending intervals
(setf intervals '(2 1 2 1 2 1 2 1 -2 -2 -1 -2 -2 -1 -2))

;; Interval-map calculates pitches from intervals starting
;; from a specific pitch
(interval-map 'c4 intervals)

; -----------------------------------------------------------
; Exercise: 
; Write the all interval row Luigi Nono used in 
; "Canto sospeso" as intervals starting from a4
; https://en.wikipedia.org/wiki/Il_canto_sospeso
; -----------------------------------------------------------

;; When the interval reaches the ambitus border
;; the direction changes until the next change in direction
;; resulting in a palindrome movement
(interval-map 'c4 '(4 4 4 4 4 4 4) :ambitus '(c4 c5))
;; => (c4 e4 gs4 c5 gs4 e4 c4 e4)

;;; ---------------------------------------------------------

;;; interval-ambitus / interval-scale

;; This interval function provides a way of restricting 
;; interval content via an ambitus operation.
(interval-ambitus 14 23) ; => 11
;; This function is operation like a pitchclass operation:
;; It reduces the interval to the octave of the interval:
;; 23 - 12 = 11 (is lower than 14)


;; This functions restricts the intervals of the input list
;; to a maximum ambitus keeping octave equivalent note names
(setf intervals '(-11 7 -17 23))
(setf interval7
      (interval-map 
       'c4 (interval-ambitus 
            7 intervals))) ; (1 3 -5 -1)

;; Compare with cmd-2
(make-omn
 :pitch (list 
         interval7
         (interval-map 
          'c4 (interval-ambitus 24 intervals)))
 :length '(q)
 :span :pitch)

;; Scaling of intervals
;; here by 2 scales the original row from one to two octaves
(setf 2octaves
(interval-map 'c4
(interval-scale 2 intervals)))

;; Scaled intervals ranged to ambitus (semitones)
;; row lies in between - 5 semitones and + 7 semitones
;; around c4
(interval-map 'c4
(interval-scale 2 intervals :ambitus '(-5 6)))

;; Scaled intervals ranged to ambitus (instrument)
(interval-map 'c4
(interval-scale 2 intervals :ambitus 'bass))

; -----------------------------------------------------------
; Exercise: 
; Write a list of any intervals up and down.
; Convert them to pitches starting with g3.
; Range the pitches in the ambitus of a violin.
; -----------------------------------------------------------

;;; interval-randomize

;; Create a number of variations from a list of intervals
;; By default only the direction is randomized
;; 3 random variations are available
(setf int-rnd (interval-randomize 3 '(2 4 -2) :seed 123))
;; ((-2 4 2) (2 4 -2) (-2 -4 2))

;; map these intervals to the starting pitch c4
(interval-map 'c4 int-rnd)

;; scale the intervals by a factor
(interval-map 'c4 (interval-scale 0.5 int-rnd))
(interval-map 'c4 (interval-scale 2 int-rnd))

;; with the keyword :rnd-order set to t (=true)
;; the intervals are shuffled randomly
(interval-map 'c4
(interval-randomize 3 '(2 4 -2) :rnd-order t :seed 12))
;; ((c5 gs4 fs4 e4) (c4 bb3 gs3) (c4 d4 e4))

