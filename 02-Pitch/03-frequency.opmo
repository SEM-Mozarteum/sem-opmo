;;; FREQUENCY

#|
Frequency is the number of occurrences of a repeating event 
per unit of time. Frequency is measured in hertz (Hz) which 
is equal to one event per second. The harmonic organisation 
of spectral music is calculated in frequencies.
|#

;;; ---------------------------------------------------------

(setf fund (pitch-to-hertz 'g1))

;; Harmonic row starting from g1 upto the 24th overtone 
;; in hertz
(setf harmonics-hz (harmonics fund 24))

;; Convert to pitch in eighth tone notation
(setf harmonics-pitch (hertz-to-pitch harmonics-hz))

;; Harmonic row in pitches (default semitones)
(setf harmonics-semi (harmonics fund 24 :type :pitch))

;; Harmonic row in quarter tones
(setf harmonics-quarter (harmonics fund 24 
                                   :type :pitch 
                                   :quantize 1/4))

;; Remaining cents from semitones
(setf remain-cents (hertz-to-midi harmonics-hz
                       :quantize 1/2 :remain t))

#|
The function cent-to-attribute converts a list of cent 
values into cent attributes. Use this function to display 
the remaining cent values from a list of floating point 
numbers after a quantisation. 
|#

;; Converting cents to attributes
(setf cents (cent-to-attribute remain-cents))

;; Harmonic scale in semitones + cent deviations
(make-omn
   :pitch harmonics-semi
   :length '(q)
   :articulation cents
   :span :pitch)

;;; ---------------------------------------------------------

;;; MICROTONES

#|
Microtones are implemented in OM as quarter- and eigthtones
because of the commonly used signs in computer notation.
All additional deviations can be displayed in cents as text
attributes, see above.
|#

;; a list of 16 random frequencies
(setf frequencies (rndn 16 200 400 :seed 678))
;; The rndn function produces random numbers:
;; arguments: n, low, high

;; A set of random pitches automatically quantised 
;; to eigth tones (default)
(hertz-to-pitch frequencies)

;; A set of random pitches quantised to quarter tones
(setf pitches (hertz-to-pitch frequencies :quantize 1/4))

;; The function quarter-tone-closest convert pitches with 
;; 3 quarter-tone alteration to 1 quarter-tone alteration.
;; You can overwrite a variable (pitches) with the same name!
(setf pitches (quarter-tone-closest pitches))