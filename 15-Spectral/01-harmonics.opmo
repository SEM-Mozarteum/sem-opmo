;;; HARMONICS

;;; ---------------------------------------------------------

#|
The harmonic series (also overtone series) is the sequence of 
harmonics, musical tones, or pure tones whose frequency is an 
integer multiple of a fundamental frequency.
|#

(progn
;; 16 pure harmonics on a2
(setf harm-hz 
      (loop for i from 1 to 17
              collect (* (pitch-to-hertz 'a2) i)))

;; quantize the frequencies from hertz to pitch
(setf harm-semi
      (hertz-to-pitch harm-hz :quantize 1/2))

;; or use the harmonics function
(harmonics 'a2 17 :quantize 1/8)

;; decimal ratios between pure harmonic row and 
;; a quantized version in semitones
(setf ratio-hz-semi 
      (loop for h in harm-hz
            for s in (pitch-to-hertz harm-semi)
            collect (/ h s)))

;; deviation of the harmonic scale from the chromatic notation
;; https://www.oberton.org/obertongesang/die-obertonreihe/
(setf cent-dev (ratio-to-cent ratio-hz-semi))
      
(make-omn
 :length '(w)
 :pitch harm-semi
 :articulation (cent-to-attribute cent-dev)
 :span :pitch)
)

;;; ---------------------------------------------------------

;;; Harmonic vs. distorted spectra

;; see Joshua Fineberg, Guide to the Basic Concepts and 
;; Techniques of Spectral Music, p. 93-94

;; harmonic scale linear quantized to quartertones
(harmonics 'c2 10 :quantize 1/4)

;; creating non-harmonic scales with distortion coefficiants
;; non-harmonic scale with exponential coefficiant
(chordize
(harmonics 'c2 10 :quantize 1/4 :coeff 0.9))

;; non-harmonic scale with logarithmic coefficiant
(harmonics 'c2 16 :quantize 1/4 :coeff 1.1)

;; (shorter coded version)
(pitch-list-plot
 (harmonics '(c2 c2 c2) '(16 16 16) :coeff '(0.8 1 1.3))
 :join-points t)

;; distorted spectra
;; (the fifth chord is the harmonic spectra)
(loop for i from 0.6 to 2.1 by 0.1
      collect
        (chordize
         (harmonics 'a2 8 :quantize 1/8 :coeff i)))

;;; ---------------------------------------------------------

;;; Frequency shifted spectra

;; see Joshua Fineberg, Guide to the Basic Concepts and 
;; Techniques of Spectral Music, p. 94-95

(setf harm-c2-10
(loop for i from 1 to 10
              collect (* (pitch-to-hertz 'c2) i)))

(setf harm-quarter
(hertz-to-pitch harm-c2-10 :quantize 1/4))

(setf harm-quart+100 (integer-transpose 100 harm-c2))

(hertz-to-pitch harm-quart+100 :quantize 1/4)

(setf harm-transp-10 (integer-transpose -10 harm-c2))

(hertz-to-pitch harm-transp-10 :quantize 1/4)

;;; ---------------------------------------------------------

;;; Linear Subdivision (Arithmetic Division)

#|
Since the harmonic series is a multiplication of integer 
factors, dividing a frequency by any integer defines this 
frequency the nth (division) overtone to the result 
as the fundamental.

Dividing this overtone by itself creates the next overtones
until the next octave above
|#

(progn
(setf fundamental (pitch-to-hertz 'a2)) ; 110 Hz
;; 4th overtone as starting point
(setf overtone (* fundamental 4)) ; 440 Hz
(setf octave-division 4) ; steps of 110 Hz

(list-plot
(setf equal-hz-scale
      ;; creating overtones 4 to 8
      (loop for i from 0 to octave-division
              ;; divide the octave in 8 steps and add 
              ;; these consecutively to the start frequency
       collect (+ overtone 
                  (* (/ overtone octave-division) i))))
:zero-based t :point-radius 2 :join-points t))

;; aequidistant increase of 110 hz per step
(difference equal-hz-scale)

;; convert to notation (pitch)
(hertz-to-pitch equal-hz-scale)

#|
Changing the division of the octave e.g. into 8 steps
with the same fundamental, the overtones 4 to 8, 
and four overtones in between are created
|#

(setf equal-hz-scale8
      (loop for i from 0 to 8  
            collect (+ overtone 
                       (* (/ overtone 8) i))))

;; convert to notation (pitch)
(hertz-to-pitch equal-hz-scale8)

;; This row corresponds to the 8th to the 16th overtone
;; on the fundamental of 55 Hz !
(setf new-fund (/ 440 8))

(loop for i from 8 to 16 ; overtones
      collect (* new-fund ;fundamental
                 i))

;; decreasing number of divisions
(loop for i from 12 downto 2 ; numbers of division
      with overtone = 440 ; overtone a4
      collect
        (chordize ; make chords
         (hertz-to-pitch ; convert frequencies to pitch
          (loop for j from 0 to i ; collect frequencies 
                collect (+ overtone ; starting overtone 
                           (* (/ overtone i) j))))))

;;; ---------------------------------------------------------
