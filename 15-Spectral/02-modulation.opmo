;;; MODULATION

;;; ---------------------------------------------------------

;;; Amplitude (Ring) Modulation

#|
Applies ring modulation to input pitches by computing both 
the frequency-sum and frequency-difference between each input 
pitch and the modulator(s).
|#

;; Modulator in Hz, quantized to semitones
(ring-modulation '(a4 c5 e5) 110 :quantize 1/2)
;; or modulator as pitch, quantized to quartertones
(ring-modulation '(a4 c5 e5) 'a2 :quantize 1/4)

;; Is the same as
(matrix-transpose
 (hertz-to-pitch
  (loop for i in (pitch-to-hertz '(a4 c5 e5))
        for mod = (pitch-to-hertz 'a2)
        collect (list (abs (- i mod)) (+ i mod)))
  :quantize 1/4))
;; Pitch is converted to hertz to calculate the modulation
;; in the frequency domain before converted back.

#|
With the keyword "am" the lists includes the original 
unmodulated pitches between difference and sum results 
in the classic amplitude modulation style
|#

;; Ring modulation as chords quantized to eighttones
(ring-modulation '(a4 c5 e5) 'a2 
                 :quantize 1/8 :am t :chord t)

;; See: Joshua Fineberg, Guide to the Basic Concepts and 
;; Techniques of Spectral Music, p. 97 

(progn
(setf spect1 '(440 880))
(setf spect2 '(80 160 240))

(setf rm-hz
(loop for a in spect1
      collect
        (loop for b in spect2
              collect (+ a b))
      collect
        (loop for b in spect2
              collect (abs (- a b)))))

;; See as pitches
(hertz-to-pitch rm-hz))

;;; ---------------------------------------------------------

;;; Frequency Modulation

;; ----------------------------------------------------------
;; See: Joshua Fineberg, Guide to the Basic Concepts and 
;; Techniques of Spectral Music, p. 96 
;; ----------------------------------------------------------

#|
The spectrum produced with this technique is expressed with 
the following equation: 

frequency = carrier +/- (index * modulator)

where index equals 1, then 2, etc. until the maximum 
index value has been reached.
|#

(progn
  (setf carrier1 440)
  (setf modulator1 100)
  (setf index1 6)

  (setf fm-hz
        (rest ; remove doubled sideband from 1. modulation
         (loop for i from 0 to index1
               for mod = (* i modulator1)
               for x = (+ carrier1 mod)
               ;; abs = only positive numbers
               for y = (abs (- carrier1 mod))
               when (not (zerop x)) collect x
                 ;; collect only if not zero
               when (not (zerop y)) collect y)))

  #|
c: 440 Hz
c + m: 540 Hz
c - m: 340 Hz
c + (2 * m): 640 Hz
c - (2 * m): 240 Hz
c + (3 * m): 740 Hz
c - (3 * m): 140 Hz
c + (4 * m): 840 Hz
c - (4 * m): 40 Hz
c + (5 * m): 940 Hz
c - (5 * m): 60  Hz
c + (6 * m): 1040 Hz
c - (6 * m): 160 Hz
|#

  ;; Display as pitches
  (chordize (hertz-to-pitch (remove-duplicates fm-hz))))

;; ----------------------------------------------------------
;; https://www.sfu.ca/~truax/fmtut.html
;; FM as C : M Ratio
;; ----------------------------------------------------------

(progn
  (setf carrier2 110)
  (setf mod-id 3)
  (setf index2 6)

  (setf fm-hz 
        (rest
         (loop for i from 0 to index2
               for mod = (* i (* carrier2 mod-id))
               for x = (+ carrier2 mod)
               for y = (abs (- carrier2 mod))
               when (not (zerop x)) collect x
               when (not (zerop y)) collect y)))

  (chordize 
   (hertz-to-pitch 
    (remove-duplicates fm-hz)
    :quantize 1/4)))

 #|
c: 110 Hz
c + m: 330 Hz
c - m: 110 Hz
c + (2 * m): 550 Hz
c - (2 * m): 330 Hz
c + (3 * m): 770 Hz
c - (3 * m): 550 Hz
c + (4 * m): 990 Hz
c - (4 * m): 770 Hz
c + (5 * m): 1210 Hz
c - (5 * m): 990  Hz
c + (6 * m): 1430 Hz
c - (6 * m): 1210 Hz
|#

;; ----------------------------------------------------------
;; fm chord progression with in increasing id
;; and modulator factor
;; ----------------------------------------------------------

(progn
  (setf carrier2 110)

  (setf fm-chords
        (loop for id from 1 to 10
              for mo from 1.5 to 2.5 by 0.1
              collect
                (remove-duplicates
                 (rest
                  (loop for i from 1 to id
                        for mod = (* i (* carrier2 mo))
                        for x = (+ carrier2 mod)
                        for y = (abs (- carrier2 mod))
                        when (not (zerop x)) collect x
                        when (not (zerop y)) collect y)))))

  (chordize 
   (hertz-to-pitch 
    (remove-duplicates fm-chords)
    :quantize 1/4)))

