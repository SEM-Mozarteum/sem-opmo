;;; interval-repeat

;;; NOT CLEAR WHAT THE ARGUMENTS ARE DOING

#|
This function generates repetitions of a single interval 
above or below a base (0).

n: number of intervals
low-change:  lowest starting id
high-change: highest starting id
low-repeat: 
high-repeat:
interval(s): repeated interval(s)
|#

(interval-to-pitch
(interval-repeat 12 4 4 2 3 5))  

(interval-to-pitch
(interval-repeat 8 2 3 2 3 '(6 7) :seed 123))

;; nur Wiederholungen, keine Veränderung
(interval-repeat 16 0 0 3 3 7 :seed 1)
;; => (7 0 0 0 -7 0 0 0 7 0 0 0 -7 0 0 0)

;; nur Veränderung, keine Wiederholung
(interval-repeat 16 4 10 1 1 7 :seed 1)
;; => (-7 7 -7 7 -7 7 0 -7 7 -7 7 -7 7 -7 7 -7)

;; Wiederholungsbereich aufziehen, Rest konstant
(interval-repeat 16 2 2 1 8 7 :seed 1)
;; => (7 -7 0 0 0 0 0 0 7 -7 0 7 -7 0 0) 

;; Änderungsbereich aufziehen, Rest konstant
(interval-repeat 16 1 12 2 2 7 :seed 1)
;; => (7 0 0 -7 7 -7 0 0 7 -7 7 -7 7 -7 7 -7)

;;; ---------------------------------------------------------

;;; Extended example

(cons 't ; add "t" (1/32 duration) for all notes 
      (loop with seed = (init-seed 234)
            repeat 4 ; create 4 lists   
            collect
              ;; converting intervals to pitch
              (interval-to-pitch  
               ;; each of the intervals is repeated       
               (interval-repeat
                ;; 5 integers between 8 and 14
                (rnd-sample 5 (gen-integer 8 14)) 
                2 3 2 3 '(12 8 6 7 3)) 
               :start 'g3))) 