;;; ASSEMBLING, DISASSEMBLING

;;; ---------------------------------------------------------

;;; subseq (lisp function) for lists

(setf lis (gen-integer 1 10))

;; rest of list from ID 2 (= 3rd position)
(subseq lis 2) ; = (3 4 5 6 7 8 9 10)

;; rest of list from ID 2 (= 3rd position) to
;; end -1 (= 4th position
(subseq lis 2 5) ; = (3 4 5)

;;; ---------------------------------------------------------

;;; assemble-subseq 

;; 2 sequences of different musical material:
(progn
(setf pitches1 (midi-to-pitch
                (loop for i from 1 to 10
                  collect 
                  (loop repeat i collect (+ 48 (random 24))))))

(setf seq-1 (make-omn
             :pitch pitches1
             :length '(1/16)
             :velocity '(f)
             :articulation '(stacc)
             :span :pitch))
                       
(setf pitches2 (midi-to-pitch
                (loop for i from 10 downto 1
                  for n from 60
                  collect (loop repeat i collect n))))   

(setf seq-2 (make-omn
             :pitch pitches2
             :length '(1/8)
             :velocity '(pp)
             :articulation'(ten)
             :span :pitch))
)

;;; ---------------------------------------------------------

;;; assemble different subsets (measures) of the materials

(setf mat-select1 (assemble-subseq 
               '((seq-1 :start 1 :end 4)
                 (seq-2 :start 1 :end 1)
                 (seq-1 :start 5 :end 7)
                 (seq-2 :start 2 :end 3)
                 (seq-1 :start 8 :end 9)
                 (seq-2 :start 4 :end 6)
                 (seq-1 :start 10 :end 10)
                 (seq-2 :start 7 :end 10))))

;; collect material alternating
(setf mat-select2 (loop for i in seq-1
                for j in seq-2
                collect i
                collect j))

;; randomly chosen measures
(loop repeat 10
        with l = (length pitches2)
      collect (nth (random l) pitches2))

;; specific measures chosen
(loop for i in '(0 9 7 9 2 8 9 6)
      collect (nth i pitches2))

;;; ---------------------------------------------------------

;;; get-events

;; assemble specific events from omn lists

(setf seq1 '((e c4e4g4 he c5)
             (q c4 c4 c4 - - c4)
             (q cs4 cs4 - - cs4 cs4)
             (e c4 cs4d4eb4 d4 cs4 c4 cs5)
             (e c4 e4 g4 he c5)
             (q c4 c4 c4 - - c4)
             (q cs4cs4 - - cs4 cs4)
             (e c4 cs4d6 d4 cs4 c4 cs5)))

;; argument list: sequence (voice), bar number, event
;; 1. voice, 1. bar, 1. event
(get-events '(1 1 1) seq1)

;; 1. voice, 4. bar, events 2 and 6
(get-events '(1 4 (2 6)) seq1)

;; events from different measures
(get-events '((1 4 2)
              (1 1 1)
              (1 8 2))
            seq1)

;;; example with random choices

;; select events randomly 
(loop repeat 10
      initially (init-seed 13)
      for measure = (rndn 1 (length seq1))
        ;;; nth (- 3 1)? korrigieren 
      for max-event = (length (nth (- 3 1) seq1))
      collect
        (get-events (list
                     1
                     measure
                     (rndn 0 max-event)) seq1))

;;; ---------------------------------------------------------

;;; select-measure

;;  extract specific bars and beats from a omn-form sequence. 

;; a diatonic scale
(setf omn
      '((q c3 q d3 q e3 q f3) 
        (q c4 q d4 q e4 q f4)
        (q c5 q d5 q e5 q f5)
        (q c6 q d6 q e6 q f6)))

;; select from 1. measure, 3. quarter 
;; to 2. measure, 1. quarter
(setf select (select-measure '(1.3 2.1) omn))

;; view with cmd-2
(list omn (append '(-q -q) select))

;; vn1 voice of Schubert D 810, 2. part
(setf vn1-mat '((h g4 pp q q) 
                (h g4 q a4 bb4) 
                (h a4 q g4 fs4) 
                (h g4 q q)))

;; the material is divided in quarter notes 
;; and rendered to 4/4 time-signature
;; select material from 2. measure, 3. quarter 
;; to 3. measure, 4. quarter
(setf sel1 (select-measure '(2.3 3.4) vn1-mat
:ratio 1/4 :time-signature '(4 4)))

;; display with cmd-2
(list vn1-mat (append '(-w -h) sel1))

;; the material is divided in eight notes 
;; select material from 2. measure, 6. eight 
;; to 3. measure, 7. eight
(setf sel2 (select-measure '(2.6 3.7) vn1-mat
:ratio 1/8 :time-signature '(4 4)))

;; display with cmd-2
(list vn1-mat (append '(-w -h -e) sel2))

;; import material with 4 voices
;; display with cmd-2
(setf 
 material
 (musicxml-to-omn
  "~/Documents/code/github/sem-opmo/11-Assembling/schubert-D810-2.musicxml"))

;; loop through all voices and collect the same sections from
;; the original score, display with cmd-2
(loop for i in material
      collect (select-measure '((3.3 4.2) 
                                (3.2 4.1) 
                                (6.3 7.4) 
                                (3.4 5.1)) i 
                              :ratio 1/4 
                              :time-signature '(4 4)))

;;; ---------------------------------------------------------

;;; disassemble-omn

;; the disassemble-omn function deconstrut the omn object in its 
;; seperate parameters
(disassemble-omn mat-select2)

;; to extract a specific parameter the omn function with the 
;; specified parameter is used, display with cmd-1
(omn :pitch seq-1)
(omn :length seq-2)
(omn :velocity mat-select2)

