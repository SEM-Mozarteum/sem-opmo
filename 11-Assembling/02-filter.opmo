;;; FILTER

;;; ---------------------------------------------------------

;;; ambitus

(setf mat '(q c4 d4 e4 f4 g4 a4 b4))

;; display with cmd-2
(list mat
(ambitus '(g3 g4) mat))

(list mat
(ambitus '(g3 g4) mat :type :invert))

;;; ---------------------------------------------------------

;;; ambitus-instrument / ambitus-filter

(setf pitches
'((3q g5 pp g3 g1 g2 c2 c4 eb1 d4 b3 e3 g4 b2) 
(3q eb4 pp e2 b3 g2 bb4 bb5 d4 b1 g3 d3 d5 b2) 
(e g3 pp cs2 gs5 a4 gs6 c7 c4 g2) 
(e bb6 pp d4 d2 g4 bb1 d3 fs5 g2) 
(e e4 pp a3 f2 a4 b5 g2 a2 b4) 
(3q a3 pp bb6 bb5 a5 g3 eb2 d7 d4 b4 g4 g2 c3) 
(e cs5 pp e3 d5 gs5 b2 b3 b4 gs6) 
(e g6 pp fs2 g2 c7 c6 g5 c5 cs5) 
(e fs6 pp eb7 b5 b4 b6 g2 c5 fs5) 
(3q bb6 pp g3 eb2 d4 bb5 a3 a5 b4 c3 g4 d7 g2) 
(e c2 pp d5 a2 e4 e3 e2 d6 g4)))

;; Use this function to get the amitus of instruments.
(integer-to-pitch (ambitus-instrument 'vibraphone))
(integer-to-pitch (ambitus-instrument 'violin))

#|
This function filters pitches, velocities and articulations
from a sequence, that are outside of a specified ambitus.
The length of the removed pitches will be converted to
rest lengths. The span of the sequence therefore stays
unaltered.
|#

;; display with cmd-2
(list pitches
(ambitus-filter 'vibraphone pitches))

;;; ---------------------------------------------------------

;;; length-legato

;; length-legato inverts length-rests to a length-note and 
;; adds the sum of the rests in sequence to the previous 
;; length-note.

(list pitches
(length-legato (ambitus-filter 'violin pitches)))

;; three voices
(list
(length-legato (ambitus-filter 'violin pitches))
(length-legato (ambitus-filter 'tenor-trombone pitches))
(length-legato (ambitus-filter 'contrabass-clarinet pitches)))

;; Filter pitches for piano notation
(setf rh (ambitus-filter '(c4 c7) pitches))
(setf lh (ambitus-filter '(c1 b3) pitches))

(def-score pno-filter
           (:key-signature 'chromatic
                           :time-signature '(4 4)
                           :tempo 80
                           :layout 
                           (piano-layout 'pno-rh 'pno-lh))
  (pno-rh
   :omn rh
   :sound 'gm :program 0)
  
  (pno-lh
   :omn lh
   :sound 'gm :program 0)) 

;;; ---------------------------------------------------------

;;; filter-first / filter-last

;; filter out the first 3 elements from a list
(filter-first 3 '(c4 d4 e4 f4 g4 a4))
;; => (c4 d4 e4)

;; Multiple lists can be used, for example - 
;; to get the first three values of each list:

(filter-first 3 '((c4 d4 e4 f4 g4 a4) (c3 d3 e3 f3 g3 a3)))
;; => ((c4 d4 e4) (c3 d3 e3))

;; Or to get the first three values of the first list, 
;; and only the first two from the second list:

(filter-first '(3 2) '((c4 d4 e4 f4 g4 a4) (c3 d3 e3 f3 g3 a3)))
;; => ((c4 d4 e4) (c3 d3))

;; filter-last works the same way
(filter-last 3 '(c4 d4 e4 f4 g4 a4))
;; => (f4 g4 a4)

;;; ---------------------------------------------------------

;;; filter-events

#| 
The function FILTER-EVENTS checks whether an event contains 
the given element. When an element is found the event is 
returned. All other events are transformed into rests. 
The option remain will invert the process. 
|#

;; retrieve from material, only chosen pitch
(setf mat1 '(e c4 mp -e fermata e. d4 -h e. c4 e e4))

(list mat1 (filter-events 'd4 mat1))

;; remain from material, everything except chosen pitch
(list mat1 (filter-events 'd4 mat1 :remain t))

(setf mat2 '(e c4 mp -e fermata+stacc e. d4 -h e. c4 e e4))

;; remove event with fermata + staccato
(list mat2 (filter-events 'fermata+stacc mat2 :remain t))

;;; ---------------------------------------------------------

;;; position-filter

;; Filter elements from a list

;; Get element 0, 2 and 5 from a list of notes
(position-filter '(0 2 5) '(c4 d4 e4 f4 g4 a4 b4 c5))
;; => (c4 e4 a4)

;; Get sublist 0 and 1 from a list of dynamic lists
(position-filter '(0 1)
                 '((ppp pp p) (pp p mp) (p mp mf) (mp mf f)))
;; => ((ppp pp p) (pp p mp))

;;; position-filter example with random

;; A list of random pitches
(setf violin (rnd-sample 24 '(c4 cs4 d4 fs4 g4 gs4 c5) :seed 356))

;; A random selection of 10 pitches from this list

(setf vn-var (position-filter
              (rndn 10 0 23 :seed 123) violin))

;; 5 different filter of the same note list
(setf vn-vars
      (loop repeat 5 
        initially (init-seed 346)
        collect
        (position-filter
         (rndn 10 0 23) violin)))

;;; more complex selections with position-filter

;; Get elements 0 and 1 from EACH sublist of notes
(position-filter '((0 1)) ; listed list!
                 '((c4 d4 e4) (f4 g4 a4) (b4 c5 d5) (e5 f5 g5)))
;; => ((c4 d4) (f4 g4) (b4 c5) (e5 f5))

;; Get elements at specific positions in sublists
(position-filter '((1 0) (0 2) (0 2) (2 0) (0 1) (0 2))
                 '((c4 d4 e4) (f4 g4 a4) (b4 c5 d5) (e5 f5 g5)))
;; => ((d4 c4) (f4 a4) (b4 d5) (g5 e5) (c4 d4) (f4 a4))