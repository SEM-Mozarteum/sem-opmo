;;; DISTRIBUTION

;;; ---------------------------------------------------------

;;; matrix-transpose

(setf random-chords
      ;; make 10 chords
      (loop repeat 10
            with seed = (init-seed 123)
            collect
              ;; convert integer to pitch
              (integer-to-pitch
               ;; sort integers from high to low
               (sort-desc
                ;; take 4 unique integers between 0 and 12
                (rnd-unique 4 (gen-integer 0 12))))))

;; listen to them as chords
(chordize random-chords)

;; Collect all the highest notes to all the lowest
;; pitches of the chords into one voice each. 
(setf pitches
      (matrix-transpose random-chords))

;; randoms lengths for homophonic chords
(setf lengths
      (rnd-sample (length (first pitches))
                  '(h h. wq w.) :seed 123))

;; View and play with cmd-2
(make-omn
 :pitch pitches
 :length lengths
 :velocity '(p)
 :span :pitch)

;;; ---------------------------------------------------------

;;; distribute-stream

#|
The function distribute-stream returns a new sequence of 
items distributed against lists of lengths sequentially.
It takes (usually) a single pitch stream and distributes 
its content amongst to a series of voices or parts. 
Other parameters like dynamics could distributed 
in a similar way.
|#

;; single pitch stream
(setf scale '(c4 cs4 d4 ds4 e4 f4 fs4 g4 gs4 a4 as4 b4))

;; and 4 lists of durations

(setf v1 '(1/8 1/8 -1/8 2/8 -1/8 5/8)
      v2 '(1/8 1/8 1/8 -1/8 2/8 1/8)
      va '(-2/8 1/8 1/8 -5/8 1/8)
      vc '(-1/8 3/8 3/8 1/8 1/8))

(setf inst (distribute-stream scale (list v1 v2 va vc)))
;; The output produces a consecutive list of pitch lists 
;; which can be assigend to seperate variables

(setf 
 in1 (make-omn :length v1 :pitch (nth 0 inst))
 in2 (make-omn :length v2 :pitch (nth 1 inst))
 in3 (make-omn :length va :pitch (nth 2 inst))
 in4 (make-omn :length vc :pitch (nth 3 inst)))

;; display with cmd-2
(list in1 in2 in3 in4)

;; an even shorter approach
(setf durations 
      '((1/8 -1/8 2/8 -1/8 5/8)
        (1/8 1/8 -1/8 2/8 1/8)
        (-2/8 1/8 -5/8 1/8)
        (-1/8 3/8 1/8 1/8)
        ))

(setf pitches (distribute-stream scale durations))

;; since make-omn accepts lists of lists, its possible to apply
;; several voices to one make-omn
;; display with cmd-2
(make-omn :pitch pitches
          :length durations)
(list
'((e c4 mf - q e4 -e he gs4) (e cs4 mf d4 - q fs4 e a4) (-q e f4 mf -he e b4) (-e q. ds4 mf e g4 as4))
'((e c4 mf - q e4 -e he gs4) (e cs4 mf d4 - q fs4 e a4) (-q e f4 mf -he e b4) (-e q. ds4 mf e g4 as4))
'((e c4 mf - q e4 -e he gs4) (e cs4 mf d4 - q fs4 e a4) (-q e f4 mf -he e b4) (-e q. ds4 mf e g4 as4))
'((e c4 mf - q e4 -e he gs4) (e cs4 mf d4 - q fs4 e a4) (-q e f4 mf -he e b4) (-e q. ds4 mf e g4 as4)))

