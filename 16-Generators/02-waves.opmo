;;; WAVES

#|
Opus Mode provides various generators based on sampled 
waveforms and their modulations:

- Sine: 
  (gen-sine, half-sine, add-sine-waves, mod-sine-waves)
- Cosine: (gen-cosine, half-cosine)
- Sigmoid: (gen-sigmoid)
- Square:
  (gen-square, half-square, add-square-waves, mod-square-waves)
- Pulse: 
  (gen-pulse, half-pulse, add-pulse-waves, mod-pulse-waves)
 -Triangle: 
  (gen-triangle, half-triangle, add-triangle-waves, mod-triangle-waves)
- Sawtooth: 
  (gen-pulse, half-pulse, add-pulse-waves, mod-pulse-waves)
- Ramp: (gen-ramp, scale-ramp)

All the half versions of the waves have no frequency argument since
they are all half of one hertz.
|#

;;; ---------------------------------------------------------

;;; gen-sine

#|
The GEN-SINE function generates a sequence with the 
characteristics of a sine wave.
With control over frequency and amplitude (and additional 
control over :phase and :modulation) this function can used 
for creating gestural forms in pitch, rhythm, dynamics 
and structure.
|#

;; sine-wave, 32 points, 1 hz, amplitude 0.5
(list-plot (gen-sine 32 1 0.5) :join-points t :point-radius 1.5)

;; sine-wave, 120 points, 4 hz, amplitude 1
(list-plot (gen-sine 120 4 1) :join-points t :point-radius 1.5)

;; Starting the same 90 degrees out of phase
(list-plot (gen-sine 120 4 1 :phase 90) :join-points t)

;;; fm: frequency modulation keyword

#|
Carrier 20 Hz: Base frequency – 20 oscillations per second
Modulator 2 Hz: Input signal – 2 oscillations per second
Modulation index 9: Strength of the modulator's influence
Frequency deviation: +/- 9 · 2 = 18 Hz ist the maximum 
one-sided deviation.
Note: only the frequency is modulated. The amplitude stays
always the same.
|#

(list-plot 
 (gen-sine 480 20 0.5 ; carrier
          :fm (gen-sine 480 2 1.0) ; modulator
          :fm-index 9) ; index
 :join-points t :point-radius 1.5)

;;; am: amplitude modulation keyword

#|
The same settings with an amplitude modulation (am)
Only the dynamic is modulated. The frequency stays
always the same.
|#

(list-plot 
 (gen-sine 480 20 0.5 ; carrier
          :am (gen-sine 480 2 1))
 :join-points t :point-radius 1.5)

;; The amplitude of the modulator determines the strength 
;; of its effect on the carrier
(list-plot 
 (gen-sine 480 20 0.5 ; carrier
          :am (gen-sine 480 2 0.5))
 :join-points t :point-radius 1.5)

;; with modulated modulator
(list-plot 
 (gen-sine 480 20 0.5 ; carrier
          :am ;; (list-plot 
               (gen-sine 480 2 0.5 
                         ;; modulator is modulated
                        :am (gen-sine 480 4 4)))
                 ;; :join-points t :point-radius 1.5))        
 :join-points t :point-radius 1.5)

;; decreasing amplitude of the sine
(list-plot
 (gen-sine 240 3 0.5
           :am (gen-transition 0.5 0.1 240 1))
 :join-points t)

;;; ---------------------------------------------------------

;;; Additive synthesis

(list-plot
 (add-sine-waves 8 240 10 0.5)
 :join-points t)

(list-plot
 (add-sine-waves 8 240 7 0.5
                   :fm (gen-sine 240 2 1.0)
                   :fm-index 1.5)
 :join-points t)

;;; ---------------------------------------------------------

;;; half-sine

#|
The half-sine function is particularly useful for creating 
various types of arc shapes
|#

;; first half of the sine wave
(list-plot (half-sine 32 0.5) :join-points t)

;; amplitude modulated half sine
(list-plot
(half-sine 240 1 ; carrier
          :am (gen-sine 240 2 0.2)) ; modulator
:join-points t)

;; modulated half sine with different amplitudes of
;; the modulator
(list-plot
 (loop for i from 0.3 by 0.3
       repeat 5
       collect
         (half-sine 120 1 ; carrier
                    :am (gen-sine 120 2 i))) ; modulator
:join-points t)

;;; ---------------------------------------------------------

;;; gen-cosine / half-cosine

;; cosine-wave, 32 points, 1 hz, amplitude 0.5
(list-plot (gen-cosine 32 1 0.5) :join-points t :point-radius 1.5)

;; cosine-wave, 120 points, 4 hz, amplitude 1
(list-plot (gen-cosine 120 4 1) :join-points t :point-radius 1.5)

;; Starting the same 90 degrees out of phase
;; (results in a sine-wave, see above)
(list-plot (gen-cosine 120 4 1 :phase -90) :join-points t)

;; Amplitude modulation with a square-wave 
(list-plot
(half-cosine 120 1 ; carrier
          :am (gen-square 120 4 1)) ; modulator
:join-points t)


;;; ---------------------------------------------------------

;;; gen-square / half-square

(list-plot (gen-square 120 3 0.5) :join-points t)  

;; Square frequency modulated by another square
(list-plot
 (gen-square 240 8 0.5
             :fm (gen-sine 240 2 1.0)
             :fm-index 3)
 :join-points t)

;; Half a square
(list-plot 
 (half-square 120 1.0 :phase 90) :join-points t) 

;;; ---------------------------------------------------------

;;; gen-sawtooth / half-sawtooth

(list-plot (gen-sawtooth 120 2 1) :join-points t)  

;; Sawtooth frequency modulated by another sawtooth
(setf saw-shape
      (list-plot
       (gen-sawtooth 120 8 0.5 
                     :am (gen-triangle 120 2 0.7))
       :join-points t))

(cons 's ; add a sixtenth note
      (integer-to-pitch
       (vector-round 0 24 saw-shape)))

;; Half sawtooth
(list-plot (half-sawtooth 120 1) :join-points t)

;;; ---------------------------------------------------------

;;; gen-triangle / half-triangle

(list-plot (gen-triangle 120 1 0.5) :join-points t)

(list-plot (setf htrng (half-triangle 32 1)) :join-points t)

(list-plot
(gen-loop 5
          (gen-deviation htrng -0.2 0.2)
          :seed 123)
:join-points t)

;;; ---------------------------------------------------------

;;; gen-pulse / half-pulse

;; default like a square wave
(list-plot (gen-pulse 32 1 0.5) :join-points t)

;; change the relation between +1 and -1 with width
(list-plot (gen-pulse 32 1 0.5 :width 0.1) :join-points t)

;; pulses with different widths
(list-plot
 (loop for i from 0.1 to 1 by 0.1
       collect
         (gen-pulse 32 1 0.5 :width i))
 :join-points t)

(list-plot (setf hpls (half-pulse 32 1)) :join-points t)

(list-plot
(gen-loop 5
          (gen-deviation hpls -0.2 0.2)
          :seed 123)
:join-points t)

;;; ---------------------------------------------------------

;;; gen-pulse / half-pulse

(list-plot
(gen-sigmoid 50 :curve 10 :center 0.3)
:join-points t)