;;; VECTOR

#|
In linear algebra, vectors are elements that indicate the way 
in which a point is moved by parallel displacement. 
Vectors are defined by their length and direction, 
i.e. they indicate the distance and direction by which a 
point is moved.
|#

;;; vector-map

#|
VECTOR-MAP enables a list of floating-point numbers to be 
related to a series of items. 
|#


(setf map '(c4 d4 e4 f4 g4 a4))

;; making a triangle of 11 values
(setf data (list-plot 
            (gen-palindrome (gen-transition 0 1 6 1))
                            :join-points t))

;; the data serves as a reader of IDs in the map
;; here going from the start to the end and back
(vector-map map data)

;; if the data has more points the map is extended accordingly
(setf new-data (list-plot 
            (gen-palindrome (gen-transition 0 1 9 1))
                            :join-points t))

(vector-map map new-data)

(hertz-to-pitch (harmonics 'c2 24))

;; If the vector is smaller than the sequence length 
;; the result is a selection of 10
(hertz-to-pitch 
 (vector-map 
  ;; 24 harmonics
  (harmonics 'c2 24)
  ;; 10 unique random numbers between 0 and 9
               (gen-integer 0 9)))

;; This map of notes goes up and down
;; When the data is a triangle the output of notes is going
;; up and down once (start to end) and up and down (end to start)
(setf new-map '(c4 d4 e4 f4 g4 f4 e4 d4 c4))

(vector-map new-map new-data)

;; if the map is shuffled the triangle reads this list
;; back and forth
(setf new-map2 '(g4 c4 f4 d4 e4 f4 c4 e4 d4))

;; symmetrical melodic shape
(vector-map new-map2 new-data)

;; 10 random numbers are mapped to different lengths
(vector-map '(1/16 1/8 1/4) 
            (list-plot
            (gen-white-noise 12 :seed 123)
            :join-points t))
;; => (1/16 1/4 1/8 1/16 1/4 1/8 1/16 1/8 1/16 1/4 1/16 1/16)

(vector-map '(q e s - -e -q) (gen-white-noise 12 :seed 98))
;; => (e s - -q q -e -e s -e e - -e)

;; The same dynamics
(vector-map '(ppp mp mf f) (gen-white-noise 10 :seed 79))
;; => (f f ppp ppp mp mf mp f ppp f)

;; Another source is mapped to pitches
(vector-map '(c4 d4 e4 f4 g4 a4 b4)
            (rnd-number 14 1 10 :norep t))
;; (e4 b4 e4 c4 b4 f4 d4 f4 e4 a4)

;; Pitches in form of a sine wave
(vector-map (integer-to-pitch (gen-integer 0 11))
            (gen-sine 12 1 0.5))
;; (fs4 gs4 bb4 b4 bb4 gs4 f4 eb4 cs4 c4 cs4 eb4)

;;; ---------------------------------------------------------

;;; There are other vector functions available to convert a 
;;; vector to a specific musical parameter

;;; vector-to-pitch

;; Make pitches from white noise, vector-to-pitch is 
;; converting the output of gen-white-noise to a given 
;; pitch range.

;; make 16 pitches between g4 and c5
;; (Variable is used below.)
(setf pitches
      (gen-loop 5 (vector-to-pitch 
                   '(g4 c5)         
                   (gen-white-noise 16))))

;; Map brownian motion between a lower and an upper limit
;; and convert to pitch
(setf brown-pitches 
      (gen-loop 5 
                (vector-to-pitch 
                 '(a2 a3) 
                 (gen-brownian-motion 50))
                :seed 123))

;; Evaluate with cmd-2 to hear 16 voices
(make-omn
 :pitch brown-pitches
 :length '(1/16)
 :span :pitch)

;; sine shape with AM and FM together
(list-plot
(setf shape
 (gen-sine 240 5 0.5
            :fm (gen-sine 240 2 1.0)
            :fm-index 2
            :am (gen-sine 240 1 1.0)
            :am-index 0.4))
 :join-points t)

;; use the shape for movement in pitches
;; listen to it with cmd-1
(make-omn
 :length '(1/32)
 :pitch (vector-to-pitch '(c1 c5) shape)
 :span :pitch)

;;; ---------------------------------------------------------

;;; vector-to-length

;; map vectors between low (-2 * 1/16) = 1/8 rest 
;; and high (4 * 1/16) = 1/4 notes
;; play with cmd-2
;; (Variable is used below.)
(setf lengths
       (gen-loop 5
                 (vector-to-length '1/16 1 4 (gen-white-noise 16))
                 :seed 123))

(setf lengths2
       (gen-loop 5
                 (vector-to-length '1/16 -2 6 (gen-white-noise 16))
                 :seed 123))

;;; ---------------------------------------------------------

;;; vector-to-velocity

;; (Variable is used below.)
(setf velocities 
      (gen-loop 5
                (velocity-to-dynamic
      (vector-to-velocity 0.2 0.45 
                          (gen-white-noise 16))) 
      :seed 123))

;; Mapping brownian result to velocity symbols
;; Show result in a velocity chart
(velocity-to-dynamic
 (velocity-list-plot
  (vector-to-velocity 'ppp 'mf 
                      (gen-brownian-motion 50 :seed 123))
  :point-radius 1.5 :join-points t))

;; Combine the parameter
(make-omn
 :length lengths
 :pitch pitches
 :velocity velocities)

;;; ---------------------------------------------------------

;;; vector-scale

#|
The function VECTOR-SCALE will scale a vector array or list 
or values between an upper and lower limit. The output is 
itself a vector array or list comprising of integer values.
|#

;; 12 integers between -5 and 12 as pitches
;; smoothed 2 times

(setf num (rndn 12 -12 12 :seed 123))
(setf scaled (vector-scale -6 6 num))
(setf scaled-more (vector-scale -3.0 3.0 num))

 (setf smooth-pitches
 (integer-to-pitch
  (list-plot
 (list num scaled scaled-more)
 :zero-based t :point-radius 2 :join-points t)))

(make-omn
 :pitch smooth-pitches
 :length '(1/4)
 :span :pitch)

#!
;; Here are the mechanics of this mapping that demonstrate 
;; how the conversion from vectors to pitches is made:
(setf mel-data1
      (vector-scale -12 12 (gen-white-noise 12 :seed 89)))
;; => (-10 12 4 -8 -4 4 12 -12 9 7 -2 7)

(integer-to-pitch mel-data1)
;; => (d3 c5 e4 e3 gs3 e4 c5 c3 a4 g4 bb3 g4)
!#

;;; ---------------------------------------------------------

;; Different scale factors in 5 voices

(pitch-plot
 ;; 24 random integers rounded to different max values
 (setf pitches-round
       (loop repeat 5
             for i downfrom 10 by 2
             collect
               (integer-to-pitch
                (vector-scale 0 i 
                              (gen-noise 24 :seed 123)))))
 :join-points t)

;; play with cmd-2
(make-omn
 :pitch pitches-round
 :length '(1/2)
 :span :pitch)

;;; ---------------------------------------------------------

;; A half-sine
(list-plot
 (setf pitch-sine
       (half-sine 50 1))
 :zero-based t :join-points t)

(list-plot
 (setf half-tend
       (gen-tendency 
        50 pitch-sine :variance 0.5))
 :zero-based t :join-points t)

;; Half sine as tendency, scaled for MIDI
(list-plot
 (setf half-sine-pitches
       (loop with seed = (init-seed 123)
             repeat 5
             collect
               (vector-scale 40 70
                             (gen-tendency 
                              50 pitch-sine :variance 0.5))))
 :zero-based t :join-points t)

;; play with cmd-2
(make-omn
 :pitch (midi-to-pitch half-sine-pitches)
 :length '(1/16)
 :span :pitch)

;;; ---------------------------------------------------------

;;; 11.6.2026 FROM HERE

;;; vector-smooth

#|
While normal scaling multiplies a value or pattern linearly, 
vector‑smooth produces a smoother transition between multiple 
values. This is typically used to avoid abrupt jumps and achieve
a more “fluid” progression.
|#

(progn ; start progn
(list-plot 
(setf vector (gen-white-noise 100 :seed 345))
 :point-radius 2 :join-points t)

;; compare the output with the smoothed ones:
(list-plot 
 (setf smoothed
 (list vector
       (vector-smooth 0.3 vector)
       (vector-smooth 0.05 vector)))
 :point-radius 2 :join-points t)
;; higher smooth vectors tend to look more and more
;; like a brownian motion.

(make-omn
 :length '(1/16)
 ;; range between e2 and c4)
 :pitch (midi-to-pitch (vector-scale 40 60 smoothed))
 :span :pitch)

;;; ---------------------------------------------------------

;;; Combination of different vector functions

(progn 

  ;; set voices and events as variables
  ;; gives the possibility to scale the output easily

  (setf voices 10)

  ;; number of events
  (setf events 50)

  ;; a list of tendencies
  (list-plot
   (setf tend-list 
         '(0.1 0.1 0.4 0.2 0.6 0.5 0.5 0.9 0.7 0.7 1 0.9 1.2 
               0.9 0.9 0.5 0.5 0.6 0.2 0.2 0.1 0.1 0.1))
   :zero-based t :join-points t)

  ;; create 10 smoothed tendencies from the tendency list
  ;; and convert them to pitches
  (pitch-plot
   (setf pitches       
         (loop with seed = (init-seed 123)
               for x from 1
               repeat voices
               collect
                 (vector-to-pitch '(c3 c5)
                                  (vector-smooth 0.6
                                                 (gen-tendency 
                                                  events tend-list :variance 0.6)))))
   :zero-based t :join-points t :style :fill)

  ;; using a sigmoid function for dynamic development
  (list-plot
   (setf sigmoid
         (gen-sigmoid events))
   :join-points t)

  (velocity-plot
   (setf velocities
         (loop with seed = (init-seed 123)
               repeat voices
               collect
                 ;; convert to dynamic symbols
                 (velocity-to-dynamic
                  ;; scale each list between 0.2 and 1
                  (vector-scale 
                   0.2 1
                   ;; smooth the tendency
                   (vector-smooth 0.8
                                  (gen-tendency 
                                   ;; tendency with variance
                                   events sigmoid :variance 0.5))))))
   :zero-based t :join-points t :style :fill)

  (setf lengths
        (gen-loop voices
                  (vector-to-length 
                   '1/4 1 4 
                   (gen-white-noise events))
                  :seed 123))

  ;; combine all parameters, view and play with cmd-2
  (assign-variable 'voice
                   (make-omn
                    :pitch pitches
                    :length lengths
                    :velocity velocities))

  ;; preview score
  (ps 'gm
      :vc (list voice1)
      :vc (list voice2)
      :vc (list voice3)
      :vc (list voice4)
      :vc (list voice5)
      :vc (list voice6)
      :vc (list voice7)
      :vc (list voice8)
      :vc (list voice9)
      :vc (list voice10)
      :time-signature '(4 4)
      :tempo 50)
  ) ; end of progn

;;; ---------------------------------------------------------

;;; Example with automatic variable assignment

(progn
  ;; number of instruments
  (setf instruments 5)

  ;; number of events
  (setf events 30)

  ;; random parameter for any number of events 
  ;; for each of the instruments
  (setf parameter
        (matrix-transpose 
         ;; collecting all individual parameters 
         ;; in a separate list of lists
         (gen-loop 
          ;; repeat process depending on the
          ;; number of instruments
          instruments 
          (list
           (vector-to-length '1/16 1 4 (gen-noise events))
           (vector-to-pitch '(g3 g5) (gen-noise events) 
                            :quantize 1/2)
           (vector-to-velocity 'pp 'f (gen-noise events)))
          :seed 123)))

  ;; make omn notation for all instruments in one
  ;; preview with cmd-2
  (setf material
        (make-omn
         :length (1~ parameter) ; 1~ = shortcut for (nth 0 list)
         :pitch (2~ parameter)
         :velocity (3~ parameter)))

  ;; create automatically as many variables as existing voices 
  ;; with the name e.g. 'mat1' - 'mat(n)' from material
  (setf voices
        (assign-variable 'mat material))

  ;; assign all the veriables to a score
  (def-score vector-score
      (:key-signature 'atonal
       :time-signature '(4 4)
       :tempo 60
       :layout (list
                (bracket-group
                 ;; group of instruments surrounded by one
                 ;; bracket with common continuous bar line
                 (violin-layout 'violin1
                                :name "Violin 1" :abbr "Vn 1")
                 (violin-layout 'violin2
                                :name "Violin 2" :abbr "Vn 2")
                 (violin-layout 'violin3
                                :name "Violin 3" :abbr "Vn 3")
                 (violin-layout 'violin4
                                :name "Violin 4" :abbr "Vn 4")
                 (violin-layout 'violin5
                                :name "Violin 5" :abbr "Vn 5"))))
               
    (violin1
     :omn mat1
     :sound 'gm
     :program 'violin)
  
    (violin2
     :omn mat2
     :sound 'gm
     :program 'violin)
  
    (violin3
     :omn mat3
     :sound 'gm
     :program 'violin)
  
    (violin4
     :omn mat4
     :sound 'gm
     :program 'violin)
  
    (violin5
     :omn mat5
     :sound 'gm
     :program 'violin))
  ) ; end of progn

