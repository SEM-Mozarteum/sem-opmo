;;; EXERCISE

#|
Use different generators to create 50 events for
- pitches in arc shape
- lengths from long to short to long
- dynamics as crescendo, slowly start and end

Combine them in [make-omn].
|#

;;; ---------------------------------------------------------

;; modulated half sine with different amplitudes of
;; the modulator

(setf pitches 
      (midi-to-pitch 
       (list-plot
        (x+b (a*x 30 (half-sine 50 1)) 60)
        :join-points t)))

(setf lengths
      (quantize
       (list-plot
        (x+b (half-sine 50 1 :phase 180) 1.2)
        :join-points t)
       '(1 2 4) :type :ratio))
        
(setf dynamics
      (velocity-to-dynamic
      (list-plot
      (x+b (a*x 0.7 (gen-sigmoid 50)) 0.2)
      :join-points t)))

(make-omn
 :pitch pitches
 :length lengths
 :velocity dynamics)