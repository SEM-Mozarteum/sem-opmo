;;; ENVELOPES

#|
Envelopes are described by a series of points with x (time) 
and y (value) coordinates, connected by segments of varying 
shapes:

Linear — straight lines between points, producing even, 
(predictable) transitions

Exponential — curved segments that accelerate or decelerate 
more rapidly

Logarithmic — curved segments that change quickly at first, 
then level off

Sinusoidal — smooth, wave-like transitions between points

Step — abrupt jumps with no transition between values

In music and audio, envelopes most commonly control amplitude 
(volume), pitch, or timbre over time — the classic example 
being the ADSR envelope (Attack, Decay, Sustain, Release). 
In computer-assisted composition, envelopes can serve as 
tendency masks, guiding stochastic processes toward or away 
from certain values across a defined time span.
|#

;; envelope with 5 breakpoints
(xy-plot 
 (setf env '(0 0  1 2  3 1  4 3  6 0))
 :join-points t :style :axis)

;;; ---------------------------------------------------------

;;; envelope-interp

;; get y-value at specific point (x-value)
(setf y-val (envelope-interp 2.5 env))

;; see env and y-val at 2.5
(xy-plot 
 (list env (list 2.5 y-val))
 :join-points t :style :axis)

;;; ---------------------------------------------------------

;;; envelope-samples

;; 20 samples from this envelope
(xy-plot
 (setf env-samp
       (envelope-samples env 20))
 :join-points t :point-radius 2 :style :axis)

;; view both envelopes
(xy-plot (list env env-samp)
 :join-points t :point-radius 2 :style :axis)

;;; ---------------------------------------------------------

;;; window-envelope

;; get a specific part of an envelope
(xy-plot
 (list env-samp
       (window-envelope 2 4.3 env-samp))
 :join-points t :point-radius 2 :style :fill)

;;; ---------------------------------------------------------

;;; envelope-length

;; see the length of the envelope (20)
(envelope-length env-samp)

;;; ---------------------------------------------------------

;;; envelope-reverse

;; reverse the envelope
(setf env-samp-rev
      (envelope-reverse env-samp))

;; compare original and reverse envelope
(xy-plot (list env-samp env-samp-rev)
 :join-points t :point-radius 2)

;;; ---------------------------------------------------------

;;; envelope-x / envelope-y

;; get the x-values
(setf env-x (envelope-x env-samp))
  
;; get the y-values
(list-plot
 (setf env-y (envelope-y env-samp))
 :join-points t :point-radius 2)

;;; ---------------------------------------------------------

;;; make-xy

;; make envelope from individual x- and y-lists
(xy-plot 
 (setf pitch-env 
       (make-xy '(0 2 3 6 7 8 14)
                '(0 4 2 5 8 3 0)))
 :join-points t)

;; map these 20 y-values to pitches
(vector-to-pitch 
 '(g3 g5)
 (envelope-y
  (envelope-samples pitch-env 24)))

;;; ---------------------------------------------------------

;;; max-envelope / min-envelope

;; get the maximum y-value (amplitude) in an envelope
(max-envelope pitch-env)

;; get the minimum y-value (amplitude) in an envelope
(min-envelope pitch-env)

;;; ---------------------------------------------------------

;;; normalize-envelope

;; normalize pitch-env between 0 and 1
;; compare it with pitch env
(xy-plot
 (list pitch-env
 (setf dyn-env (normalize-envelope pitch-env)))
 :join-points t)

;; map the normalized envelope between 0.1 and 0.9 and
;; convert to dynamics
(velocity-plot
(vector-to-velocity 0.1 0.9 (envelope-y dyn-env))
:join-points t :style :axis :zero-based t)

;;; ---------------------------------------------------------

;;; envelope-exp

;; change the linear envelope exponentially curved
(xy-plot
 (list env-samp ; linear
       (envelope-exp env-samp 0.5 20) ; concave
       (envelope-exp env-samp 2.0 20)) ; convex
         :point-radius 2 :join-points t)

;;; ---------------------------------------------------------

;;; envelope-increase
;;; (envelope-decrease, envelope-divide, envelope-multiply)

;; Two or more envelopes are combined by addition of y values 
;; across shared breakpoint positions.

(xy-plot
(setf inc-envs
 (gen-loop 10
           ;; (0 0  1 2  3 1  4 3  6 0)
           (envelope-increase 
            env
            ;; creating a random env from fixed 
            ;; x-values and random additions to 
            ;; the y-values between 0 and 2
            (list 0 (rndn 1 0 2.0)
                  1 (rndn 1 0 2.0)
                  3 (rndn 1 0 2.0)
                  4 (rndn 1 0 2.0)
                  6 (rndn 1 0 2.0)))
           :seed 258)) ;; fix the output
 :join-points t)

;; Take 160 samples (10 maeasures of 1/16) from each envelope
(list-plot
(setf inc-env-samples
      (loop for i in inc-envs
            collect (envelope-y (envelope-samples i 160))))
 :join-points t)

;; Convert them to pitches
(setf inc-env-pitches
      (vector-to-pitch
       '(c4 c6)
       inc-env-samples))
       
;; view with cmd-2
(make-omn
 :length '(1/16)
 :pitch inc-env-pitches
 :span :pitch)

;;; ---------------------------------------------------------

;;; Random limits with envelopes (see chapter Vector/Envelopes)

;; the lower limit of the tendency
;; envelope with 50 values, return y-values
(setf lowlim 
      (list-plot
       (envelope-y (envelope-samples 
                    '(0 0 1 -1 2 1 3 -2 4 3 5 -1 6 0) 50))
       :join-points t  :point-radius 2))

;; the upper limit of the tendency
(setf uplim 
      (list-plot
       (envelope-y 
        (envelope-samples 
         '(0 1 1 4 2 2 3 4 6 4) 50))
       :join-points t  :point-radius 2))

;; random between upper and lower limits
(list-plot 
 (list lowlim uplim
       (loop  with seed = (init-seed 123)
              for i in uplim ; upper limit
              for j in lowlim ; lower limit
              ;; random number between upper and lower limit
              collect (rndn j i))) 
 :join-points t)

;;; ---------------------------------------------------------

;;; Brownian motion inside a tendency with two envelopes
;;; as lower and upper limit

(progn ; evaluate with cmd-1

  (setf data-len 50) ; number of events

  (list-plot
   ;; brownian motion between -1 and 1 (default)
   ;; with high amp to reach these limits
   (setf data 
         (gen-brownian-motion data-len :amp 20 :seed 123))
   :join-points t)
  
  ;; envelope for lower limit
  (setf l-limit 
        (envelope-samples 
         '(0 0 1 -1 2 -1 3 -2 4 3 5 -1 6 0) data-len))
  
  ;; envelope for upper limit
  (setf u-limit 
        (envelope-samples '(0 1 1 4 2 2 3 4 6 4) data-len))

  ;; make tendency from brownian motion between the two limits
  (setf gen-tend
        (gen-envelope-tendency data l-limit u-limit))

  ;; map the 50 tendency values to the min-x 
  ;; and max-x of the limits to calculate the x-values for
  ;; the tendency list (gen-tend)
  (setf x-values
        (vector-range 
         ;; limits have x-values between 0 and 6
         0 6 ; new range
         (gen-integer
          ;; tendency has 50 values
          0 (1- (length gen-tend))) ; old range
         ))
  
  ;; make envelope data with new x-values
  (setf xy-data
        (make-xy x-values gen-tend))

  ;; view brownian motion with upper and lower limits
  (xy-plot
   (list xy-data l-limit u-limit)
   :point-radius 2 :join-points t)

   (make-omn
    :length '(1/16)
    :pitch (vector-to-pitch '(c4 c6) gen-tend)
    :velocity '(mp)
    :span :pitch)
) ; end of progn
