;;; EXERCISE

#|
Use different generators to create 50 events for
- pitches in arc shape
- lengths from long to short to long
- dynamics as crescendo, slowly start and end
- Combine them in [make-omn].
|#

;;; ---------------------------------------------------------

(setf events 50)

(setf pitches
(vector-to-pitch '(c3 c6)
(list-plot
(half-sine events 1)
:join-points t)))

#|
(hertz-to-pitch
(loop for i in 
(vector-scale 1 12
(half-sine events 1))
      collect (* i 50)))
|#

(setf lengths
(quantize
(vector-scale 0.25 1
(half-sine events 1 :phase 180))
'(1 2 3 4)))

(setf dynamics
(velocity-to-dynamic
(vector-scale 0.1 0.8
(gen-sigmoid events))))

(make-omn
 :length lengths
 :pitch pitches
 :velocity dynamics)


