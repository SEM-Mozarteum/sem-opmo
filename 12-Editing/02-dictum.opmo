;;; DICTUM

;;; ---------------------------------------------------------

#|
DICTUM is an editing tool which allows you to edit any event 
(l=length, p=pitch, v=velocity, a=amplitude and articulations)
 in a sequence. The elements and their values can be 
changed, removed or added by applying dictum arguments to one 
or all events within a sequence. 
The dictum arguments can be seen as maps, rules or as 
handwritten  corrections to an omn sequence or to a final 
score. Dictum arguments are applied in consecutive order 
to all or selected bars or events.
|#

;;; ---------------------------------------------------------

(setf omn '(e g4 f leg gs4 fs4 mf leg a4 s f4 p bb4 e4 b4 eb4 c5 d4 cs5))

;; remove all velocities
;; see original and changed result with cmd-2
(list omn
(dictum '(:remove :velocity) omn))

;; remove the mezzoforte
(list omn
(dictum '(:remove mf) omn))

;; add staccato to all sixteenth notes
(list omn
(dictum '(:if s :do stacc) omn))

;; change any legato start to a trill
;; (the legato is removed) 
;; and apply forte to all notes
(list omn
(dictum '((:if leg :do tr1) (:do f)) omn))

;; change any eights to forte staccato
;; any sixteenth to mp legato
(list omn
(dictum '((:if e :do (f stacc))
          (:if s :do (mp leg))) omn))

;; add to any eigth note legato and tenuto
(list omn
(dictum '(:if e :do leg+ten) omn))

;; change events 1 and 3 to pizzicato glissandi,
;; remove the mezzoforte
;; and change all sixteenth to legato tasto
(list omn
(dictum '((:do gliss+pizz :event 1)
          (:do gliss+pizz :event 3)
          (:remove mf)
          (:if s :do leg+tasto)) omn))

;; shorter
(list omn
(dictum '((:do gliss+pizz :event '(1 3))
          (:remove mf)
          (:if s :do leg+tasto)) omn))

;;; ---------------------------------------------------------

(setf omn2 
      '((5q fs4 p - bb3 f3 e4 -3q g4 c5 s eb5 mf a5 cs6 gs6)
             (5q gs6 f cs6 a5 eb5 - -t c5 g4 e4)))

;; transpose all sixteenth and thirty-second notes by 
;; 7 semitones down add tenuto to all eight note triplets
(list omn2
;; when using a function inside dictum an "x" has to be
;; applied as input argument
(dictum '((:within (t s) :do (pitch-transpose -7 x))
          (:if 3q :do ten)) omn2))

;; add staccato articulation to all sixteeth notes in bar 1
;; add legato to all eights and quintuplets i bar 2
(list omn2
(dictum '((:if s :do stacc :bar 1)
          (:if s :do leg :bar 2)
          (:if 5q :do leg :bar 2)) omn2))

;; shorter
(list omn2
(dictum '((:if s :do stacc :bar 1)
          (:if '(s 5q) :do leg :bar 2)) omn2))

;; remove event 3 in bar 1 and event 1 in bar  2
(list omn2
(dictum '((:remove :event :bar 1 :event 3)
          (:remove :event :bar 2 :event 1)) omn2))

;; first remove all dynamic signs
;; then add new ones with crescendo
;; add legato to the crescendo
(list omn2
(dictum '((:remove :velocity)
          (:do p :bar 1 :event 7)
          (:do < :bar 1 :event (8 9 10 11))
          (:do f :bar 1 :event 12)
          (:do leg :event (7..11) :bar 1)) omn2))

;;; ---------------------------------------------------------

(setf omn5 '(q b3eb4gs4 a3d4fs4 e bb3cs4f4 gs3b3e4
             s g3c4eb4 gs3b3e4 bb3d4f4 a3cs4fs4))

;; by default dechord is extracting the lowest note 
;; of each chord, all notes within 1/32 and 1/16 duration
;; display with cmd-2
(list omn5
(dictum '(:within (t s) :do (dechord x)) omn5))

;; transpose all notes between b3 and f4 by 7 semitones
(list omn5
(dictum '(:within (b3 f4) :do (pitch-transpose 7 x)) omn5))
