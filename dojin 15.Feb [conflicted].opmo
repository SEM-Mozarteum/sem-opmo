;;; EXERCISE

;; Make a short sketch for flute and violoncello using permutations 
;; of pitch and duration. Look under def-score how to layout them. 
;; Use different time-signatures and tempos.

;;; This exercise will come in one of the next lessons ....

;;; ---------------------------------------------------------
;;; Wrong paranthesis
;;; ---------------------------------------------------------

#|
((setf mat-fl 
      '((3q cs5 pp c6 cs6 p 5q ds6 pp d5 mp f4 pp fs5 a6 -h s f5 mp fs4 mp g4 pp gs5 mf 3q g4 p gs5 mp b4 pp -h 5q cs4 p cs5 ds4 mf e4 pp f5 pp e gs4 gs5 
         pp es4 p fs5 mp f4 pp 3q gs4 p gs5 mp c4 -q s d5 pp es5 p fs5 mf f4 pp 3q gs4 p g5 mp as4 mf 3q as4 mf c6 pp cs6 3q gs4 f as4 pp ds4 mf 3q d5 
         mp ds5 f ds6 pp es4 p 3q fs5 pp f5 mf gs4 pp 3q ds6 pp ds6 mf ds6 mp c7 f cs5 pp -q 3q ds6 p ds6 pp d6 pp )))

(setf mat-vc 
      '((3q cs2 pp c2 cs2 p 5q ds2 pp d2 mp f2 pp gs3 cs2 -h s b3 mp fs2 mp gs2 pp gs3 mf 3q g2 p gs2 mp b3 pp -h 5q cs2 p cs2 ds3 mf e3 pp f3 pp e gs3 gs3 
         pp fs3 p f2 mp f2 pp 3q g3 p g2 mp cs2 -q s ds4 pp e4 p fs4 mf fs3 pp 3q g4 p g5 mp as4 mf 3q as4 mf c6 pp cs2 3q gs3 f e3 pp d3 mf 3q d2 
         mp ds2 f ds3 pp e3 p 3q f4 pp f3 mf g3 pp 3q ds2 pp ds2 mf ds2 mp c5 f cs5 pp 5q cs2 cs2 cs2 cs2 cs2 3q ds5 p ds5 pp cs2 pp e c2 ppp))))
|#

;;; ---------------------------------------------------------
;;; You can write it like this, with progn
;;; ---------------------------------------------------------

(progn
(setf mat-fl 
      '((3q cs5 pp c6 cs6 p 5q ds6 pp d5 mp f4 pp fs5 a6 -h s f5 mp fs4 mp g4 pp gs5 mf 3q g4 p gs5 mp b4 pp -h 5q cs4 p cs5 ds4 mf e4 pp f5 pp e gs4 gs5 
         pp es4 p fs5 mp f4 pp 3q gs4 p gs5 mp c4 -q s d5 pp es5 p fs5 mf f4 pp 3q gs4 p g5 mp as4 mf 3q as4 mf c6 pp cs6 3q gs4 f as4 pp ds4 mf 3q d5 
         mp ds5 f ds6 pp es4 p 3q fs5 pp f5 mf gs4 pp 3q ds6 pp ds6 mf ds6 mp c7 f cs5 pp -q 3q ds6 p ds6 pp d6 pp )))

(setf mat-vc 
      '((3q cs2 pp c2 cs2 p 5q ds2 pp d2 mp f2 pp gs3 cs2 -h s b3 mp fs2 mp gs2 pp gs3 mf 3q g2 p gs2 mp b3 pp -h 5q cs2 p cs2 ds3 mf e3 pp f3 pp e gs3 gs3 
         pp fs3 p f2 mp f2 pp 3q g3 p g2 mp cs2 -q s ds4 pp e4 p fs4 mf fs3 pp 3q g4 p g5 mp as4 mf 3q as4 mf c6 pp cs2 3q gs3 f e3 pp d3 mf 3q d2 
         mp ds2 f ds3 pp e3 p 3q f4 pp f3 mf g3 pp 3q ds2 pp ds2 mf ds2 mp c5 f cs5 pp 5q cs2 cs2 cs2 cs2 cs2 3q ds5 p ds5 pp cs2 pp e c2 ppp))))

;;; ---------------------------------------------------------
;;; or like this, setf several variables at the same time.
;;; ---------------------------------------------------------

(setf mat-fl 
      '((3q cs5 pp c6 cs6 p 5q ds6 pp d5 mp f4 pp fs5 a6 -h s f5 mp fs4 mp g4 pp gs5 mf 3q g4 p gs5 mp b4 pp -h 5q cs4 p cs5 ds4 mf e4 pp f5 pp e gs4 gs5 
            pp es4 p fs5 mp f4 pp 3q gs4 p gs5 mp c4 -q s d5 pp es5 p fs5 mf f4 pp 3q gs4 p g5 mp as4 mf 3q as4 mf c6 pp cs6 3q gs4 f as4 pp ds4 mf 3q d5 
            mp ds5 f ds6 pp es4 p 3q fs5 pp f5 mf gs4 pp 3q ds6 pp ds6 mf ds6 mp c7 f cs5 pp -q 3q ds6 p ds6 pp d6 pp ))

      mat-vc 
      '((3q cs2 pp c2 cs2 p 5q ds2 pp d2 mp f2 pp gs3 cs2 -h s b3 mp fs2 mp gs2 pp gs3 mf 3q g2 p gs2 mp b3 pp -h 5q cs2 p cs2 ds3 mf e3 pp f3 pp e gs3 gs3 
            pp fs3 p f2 mp f2 pp 3q g3 p g2 mp cs2 -q s ds4 pp e4 p fs4 mf fs3 pp 3q g4 p g5 mp as4 mf 3q as4 mf c6 pp cs2 3q gs3 f e3 pp d3 mf 3q d2 
            mp ds2 f ds3 pp e3 p 3q f4 pp f3 mf g3 pp 3q ds2 pp ds2 mf ds2 mp c5 f cs5 pp 5q cs2 cs2 cs2 cs2 cs2 3q ds5 p ds5 pp cs2 pp e c2 ppp)))

;;; ---------------------------------------------------------
;;; Note that your list don't have the same length: 47/8 and 24/4 !!!
;;; Layout and name are not in voices. It's part of the score definition.
;;; See "def-score" ":layout" and "Instrument Layout Presets" in Documentation
;;; ---------------------------------------------------------

(def-score score-name
  (:title "homework"
   :key-signature 'atonal
   :time-signature '(4 4)
   :tempo 60
   :layout (list 
            (flute-layout 'fl)
            (violoncello-layout 'vc)))

  (fl
   ;; :name 'Flute
   :omn mat-fl
   :channel 1
   :sound 'gm
   :program 'flute)
   ;;:layout (bracket-group 'fl 'vc))

  (vc
   ;; :name 'Violoncello
   :omn mat-vc
   :channel 2
   :sound 'gm
   :program 'cello))
   ;; :program 'violoncello))
   ;;:layout (bracket-group 'fl 'vc)))

;;; ---------------------------------------------------------
;;; function is for importing a score
;;; ---------------------------------------------------------
;; (musicxml-to-score "homework.xml")
(musicxml-to-editor :file "homework.xml")

;;; ---------------------------------------------------------
;;; function does not exist
;;; ---------------------------------------------------------
;; (score-view 'score-name)
(display-musicxml 'score-name)