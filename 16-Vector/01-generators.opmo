;;; GENERATORS

;;; ---------------------------------------------------------

;;; gen-white-noise / (list-plot)

#|
The function GEN-WHITE-NOISE generate N samples of white 
noise specified by the keyword :type.
Types are: :normal :binary :cauchy :chi-square-2 :exponential 
:extreme :gaussian :logistic :lognormal :triangular 
:low-pass :high-pass.

To demonstrate the different :type of the GEN-WHITE-NOISE 
function we use LIST-PLOT with a :seed number.

List-plot generates a graph from the data provided in 
sequences. Sequences may be either a single sequence of real 
numbers, or a series of such sequences.  Each number in a 
sequence represents a y-coordinate. 
Numbers are positioned along the x axis according to their 
position in the sequence.
By default points are plotted starting at x = 1. If 
:zero-based is T, points will start being plotted at the 
x coordinate of 0. The points are drawn as circles. 
:point-radius lets you control the size of the circles. 
If 0, the points will not be drawn. If :join-points is T, 
the points (whether visible or not) will be connected with 
line segments. The :style keyword argument may be either 
:axis or :fill.
|#

;; normal
(list-plot (gen-white-noise 1000)
           :point-radius 2)

;; binary
(list-plot (gen-white-noise 100 :type :binary :seed 23)
           :join-points t :point-radius 1.5 :style :fill)

;; exponential (more lower then higher values)
(list-plot (gen-white-noise 100 :type :exponential)
           :join-points t :point-radius 1.5 :style :axis)

;; gaussian
(list-plot (gen-white-noise 100 :type :gaussian :seed 23)
           :join-points nil :point-radius 2.5)

;; There is another function only for gaussian noise:
(list-plot (gen-gaussian-noise 500 :seed 123)
 :join-points nil :point-radius 2 )

;; high-pass
(list-plot (gen-white-noise 100 :type :high-pass :seed 23)
           :join-points t :point-radius 2)

;; low-pass
(list-plot (gen-white-noise 100 :type :low-pass)
           :join-points t :point-radius 2)

;;; ---------------------------------------------------------

;;; gen-sine

#|
The GEN-SINE function generates a sequence with the 
characteristics of a sine wave.
With control over frequency and amplitude (and additional 
control over :phase and :modulation) this function can used 
for creating gestural forms in pitch, rhythm, dynamics 
and structure.
|#

;; sine-wave, 32 points, 1 hz, amplitude 0.5
(list-plot (gen-sine 32 1 0.5) :join-points t :point-radius 1.5)

;; sine-wave, 120 points, 4 hz, amplitude 1
(list-plot (gen-sine 120 4 1) :join-points t :point-radius 1.5)

;; Starting the same 90 degrees out of phase
(list-plot (gen-sine 120 4 1 :phase 90) :join-points t)

;;; fm: frequency modulation keyword

#|
Carrier 20 Hz: Base frequency – 20 oscillations per second
Modulator 2 Hz: Input signal – 2 oscillations per second
Modulation index 9: Strength of the modulator's influence
Frequency deviation: +/- 9 · 2 = 18 Hz ist the maximum 
one-sided deviation.
Note: only the frequency is modulated. The amplitude stays
always the same.
|#

(list-plot 
 (gen-sine 480 20 0.5 ; carrier
          :fm (gen-sine 480 2 1.0) ; modulator
          :fm-index 9) ; index
 :join-points t :point-radius 1.5)

;;; am: amplitude modulation keyword

#|
The same settings with an amplitude modulation (am)
Only the dynamic is modulated. The frequency stays
always the same.
|#

(list-plot 
 (gen-sine 480 20 0.5 ; carrier
          :am (gen-sine 480 2 1))
 :join-points t :point-radius 1.5)

;; The amplitude of the modulator determines the strength 
;; of its effect on the carrier
(list-plot 
 (gen-sine 480 20 0.5 ; carrier
          :am (gen-sine 480 2 0.5))
 :join-points t :point-radius 1.5)

;; with modulated modulator
(list-plot 
 (gen-sine 480 20 0.5 ; carrier
          :am ;; (list-plot 
               (gen-sine 480 2 0.5 
                         ;; modulator is modulated
                        :am (gen-sine 480 4 4)))
                 ;; :join-points t :point-radius 1.5))        
 :join-points t :point-radius 1.5)

;;; ---------------------------------------------------------

;;; half-sine

;; first half of the sine wave
(list-plot (half-sine 32 0.5) :join-points t)

;; amplitude modulated half sine
(list-plot
(half-sine 240 1 ; carrier
          :am (gen-sine 240 2 0.5)) ; modulator
:join-points t)

;; modulated half sine with different amplitudes of
;; the modulator
(list-plot
 (loop for i from 0.3 by 0.1
       repeat 5
       collect
         (half-sine 120 1 ; carrier
                    :am (gen-sine 120 2 i))) ; modulator
:join-points t)

;;; ---------------------------------------------------------

;;; gen-square / half-square

(list-plot (gen-square 120 3 0.5) :join-points t)  

;; Square frequency modulated by another square
(list-plot
 (gen-square 240 8 0.5
             :fm (gen-sine 240 2 1.0)
             :fm-index 3)
 :join-points t)

;; Half a square
(list-plot (half-square 120 1.0 :phase ) :join-points t) 

;;; ---------------------------------------------------------

;;; gen-sawtooth / half-sawtooth

(list-plot (gen-sawtooth 120 3 0.5)
       :join-points t)  

;; Sawtooth frequency modulated by another sawtooth
(list-plot
 (gen-sawtooth 120 4 0.5 
             :modulation (gen-sawtooth 120 1 0.7))
 :join-points t)

;; Half sawtooth
(list-plot (half-sawtooth 120 1 :phase 90) :join-points t)

;;; ---------------------------------------------------------

;;; gen-triangle / half-triangle

(list-plot (gen-triangle 32 1 0.5) :join-points t)
(list-plot (half-triangle 32 0.5) :join-points t)
(list-plot (half-triangle 120 1.0 :phase 45) :join-points t :zero-based t)